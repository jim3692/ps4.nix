From c0c50f0e260f420af86c051588cbf9838f4bb74e Mon Sep 17 00:00:00 2001
From: Armandas Kvietkus <armandas.kvietkus@proton.me>
Date: Tue, 10 Nov 2026 23:31:25 +0100
Subject: [PATCH 123/124] amdgpu: gladius: drop the pro mode switch, warn in
 base mode

Signed-off-by: Armandas Kvietkus <armandas.kvietkus@proton.me>
---
 drivers/gpu/drm/amd/amdgpu/gfx_v7_0.c | 9 +++------
 1 file changed, 3 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/gfx_v7_0.c b/drivers/gpu/drm/amd/amdgpu/gfx_v7_0.c
index 89b58e7614d07ffea39f5103774f77d426da3090..7d8bc1e802a27db5e00808f0d33d8148882939dc 100644
--- a/drivers/gpu/drm/amd/amdgpu/gfx_v7_0.c
+++ b/drivers/gpu/drm/amd/amdgpu/gfx_v7_0.c
@@ -1576,13 +1576,10 @@ static int gfx_v7_0_init_microcode(struct amdgpu_device *adev)
 	if (adev->asic_type == CHIP_GLADIUS) {
 		u32 mode = RREG32(0x203e);
 
-		if (!(mode & 0x10)) {
-			WREG32(0x203e, (mode & 0xffffffe4) | 0x10);
-			WREG32(0x341b, RREG32(0x341b) & ~1);
-			WREG32(0x361b, RREG32(0x361b) & ~1);
-			dev_info(adev->dev, "Gladius base mode 0x%08x, switched to pro mode\n",
+		if (mode & 1)
+			dev_warn(adev->dev,
+				 "Gladius is in base mode (0x203e 0x%08x), start the loader from the home screen\n",
 				 mode);
-		}
 		cp_name = (RREG32(0x203e) & 1) ? "gladius_a" : "gladius_b";
 		dev_info(adev->dev, "Gladius cp microcode %s (0x203e 0x%08x)\n",
 			 cp_name, RREG32(0x203e));
