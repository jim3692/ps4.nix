+
+#define UPDCTRL 0x7011
+#define UPDCTRL_ALLUPD BIT(7)
+#define UPDCTRL_AVIIUPD BIT(6)
+#define UPDCTRL_AUDIUPD BIT(5)
+#define UPDCTRL_CLKUPD BIT(4)
+#define UPDCTRL_HVSIUPD BIT(3)
