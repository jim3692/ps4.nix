From f8f9f106951b70206a9364e41c74e28428f2f05f Mon Sep 17 00:00:00 2001
From: Armandas Kvietkus <armandas.kvietkus@proton.me>
Date: Sun, 15 Mar 2026 18:37:19 +0100
Subject: [PATCH 013/124] net: sky2: fix the interrupt storm and the device ids
 on ps4

Signed-off-by: Armandas Kvietkus <armandas.kvietkus@proton.me>
---
 drivers/net/ethernet/marvell/sky2.c | 19 ++++++-------------
 drivers/net/ethernet/marvell/sky2.h | 14 +++-----------
 2 files changed, 9 insertions(+), 24 deletions(-)

diff --git a/drivers/net/ethernet/marvell/sky2.c b/drivers/net/ethernet/marvell/sky2.c
index 2c83c17ea20a99e34949b65d0f54328135183cc0..cbb9abb2357328b6352d988ee31d18471ea93ba4 100644
--- a/drivers/net/ethernet/marvell/sky2.c
+++ b/drivers/net/ethernet/marvell/sky2.c
@@ -141,7 +141,6 @@ static const struct pci_device_id sky2_id_table[] = {
 	{ PCI_DEVICE(PCI_VENDOR_ID_MARVELL, 0x4382) }, /* 88E8079 */
 	{ PCI_DEVICE(PCI_VENDOR_ID_SONY, PCI_DEVICE_ID_SONY_AEOLIA_GBE) },
 	{ PCI_DEVICE(PCI_VENDOR_ID_SONY, PCI_DEVICE_ID_SONY_BELIZE_GBE) },
-	{ PCI_DEVICE(PCI_VENDOR_ID_SONY, PCI_DEVICE_ID_SONY_BAIKAL_GBE) },
 	{ 0 }
 };
 
@@ -217,7 +216,6 @@ static inline u16 gm_phy_read(struct sky2_hw *hw, unsigned port, u16 reg)
 	return v;
 }
 
-
 static void sky2_power_on(struct sky2_hw *hw)
 {
 	/* switch power to VCC (WA for VAUX problem) */
@@ -330,7 +328,6 @@ static const u16 gm_fc_disable[] = {
 	[FC_BOTH] = 0,
 };
 
-
 static void sky2_phy_init(struct sky2_hw *hw, unsigned port)
 {
 	struct sky2_port *sky2 = netdev_priv(hw->dev[port]);
@@ -1138,7 +1135,6 @@ static inline void sky2_put_idx(struct sky2_hw *hw, unsigned q, u16 idx)
 	sky2_write16(hw, Y2_QADDR(q, PREF_UNIT_PUT_IDX), idx);
 }
 
-
 static inline struct sky2_rx_le *sky2_next_rx(struct sky2_port *sky2)
 {
 	struct sky2_rx_le *le = sky2->rx_le + sky2->rx_put;
@@ -1211,7 +1207,6 @@ static void sky2_rx_submit(struct sky2_port *sky2,
 		sky2_rx_add(sky2, OP_BUFFER, re->frag_addr[i], PAGE_SIZE);
 }
 
-
 static int sky2_rx_map_skb(struct pci_dev *pdev, struct rx_ring_info *re,
 			    unsigned size)
 {
@@ -1737,7 +1732,6 @@ static int sky2_setup_irq(struct sky2_hw *hw, const char *name)
 	return err;
 }
 
-
 /* Bring up network interface. */
 static int sky2_open(struct net_device *dev)
 {
@@ -1937,7 +1931,6 @@ static netdev_tx_t sky2_xmit_frame(struct sk_buff *skb,
 	le->ctrl = ctrl;
 	le->opcode = mss ? (OP_LARGESEND | HW_OWNER) : (OP_PACKET | HW_OWNER);
 
-
 	for (i = 0; i < skb_shinfo(skb)->nr_frags; i++) {
 		const skb_frag_t *frag = &skb_shinfo(skb)->frags[i];
 
@@ -3053,6 +3046,9 @@ static int sky2_poll(struct napi_struct *napi, int work_limit)
 
 	napi_complete_done(napi, work_done);
 	sky2_read32(hw, B0_Y2_SP_LISR);
+#ifdef CONFIG_X86_PS4
+	sky2_write32(hw, AEOLIA_SP_ICR,1);
+#endif
 done:
 
 	return work_done;
@@ -3062,8 +3058,9 @@ static irqreturn_t sky2_intr(int irq, void *dev_id)
 {
 	struct sky2_hw *hw = dev_id;
 	u32 status;
-
-	/* Reading this mask interrupts as side effect */
+#ifdef CONFIG_X86_PS4
+	sky2_write32(hw, AEOLIA_SP_ICR, 2);
+#endif
 	status = sky2_read32(hw, B0_Y2_SP_ISRC2);
 	if (status == 0 || status == ~0) {
 		sky2_write32(hw, B0_Y2_SP_ICR, 2);
@@ -3071,7 +3068,6 @@ static irqreturn_t sky2_intr(int irq, void *dev_id)
 	}
 
 	prefetch(&hw->st_le[hw->st_idx]);
-
 	napi_schedule(&hw->napi);
 
 	return IRQ_HANDLED;
@@ -3124,7 +3120,6 @@ static inline u32 sky2_clk2us(const struct sky2_hw *hw, u32 clk)
 	return clk / sky2_mhz(hw);
 }
 
-
 static int sky2_init(struct sky2_hw *hw)
 {
 	u8 t8;
@@ -4552,7 +4547,6 @@ static struct notifier_block sky2_notifier = {
 	.notifier_call = sky2_device_event,
 };
 
-
 static __init void sky2_debug_init(void)
 {
 	struct dentry *ent;
@@ -4963,7 +4957,6 @@ static int sky2_probe(struct pci_dev *pdev, const struct pci_device_id *ent)
 		}
 	}
 
-
 #ifdef __BIG_ENDIAN
 	/* The sk98lin vendor driver uses hardware byte swapping but
 	 * this driver uses software swapping.
diff --git a/drivers/net/ethernet/marvell/sky2.h b/drivers/net/ethernet/marvell/sky2.h
index 33f5145ede89bc2822cbb81b6fe3ab24505898f4..5d70b81ef6352c1828bb42b43926d65753254f16 100644
--- a/drivers/net/ethernet/marvell/sky2.h
+++ b/drivers/net/ethernet/marvell/sky2.h
@@ -251,7 +251,6 @@ enum {
 	PSM_CONFIG_REG4_RST_PHY_LINK_DETECT = 1<<0, /* Reset GPHY Link Detect */
 };
 
-
 enum csr_regs {
 	B0_RAP		= 0x0000,
 	B0_CTST		= 0x0004,
@@ -268,6 +267,9 @@ enum csr_regs {
 	B0_Y2_SP_EISR	= 0x0024,
 	B0_Y2_SP_LISR	= 0x0028,
 	B0_Y2_SP_ICR	= 0x002c,
+#ifdef CONFIG_X86_PS4
+	AEOLIA_SP_ICR	= 0x0068,
+#endif
 
 	B2_MAC_1	= 0x0100,
 	B2_MAC_2	= 0x0108,
@@ -608,7 +610,6 @@ enum {
 #define CFG_LED_MODE(x)		(((x) & CFG_LED_MODE_MSK) >> 2)
 #define CFG_DUAL_MAC_MSK	(CFG_LINK_2_AVAIL | CFG_LINK_1_AVAIL)
 
-
 /* B2_Y2_CLK_CTRL	32 bit	Clock Frequency Control Register (Yukon-2/EC) */
 enum {
 	Y2_CLK_DIV_VAL_MSK	= 0xff<<16,/* Bit 23..16: Clock Divisor Value */
@@ -660,7 +661,6 @@ enum {
 
 #define SK_RI_TO_53	36		/* RAM interface timeout */
 
-
 /* Port related registers FIFO, and Arbiter */
 #define SK_REG(port,reg)	(((port)<<7)+(reg))
 
@@ -817,7 +817,6 @@ enum {
 
 #define RB_ADDR(offs, queue) ((u16) B16_RAM_REGS + (queue) + (offs))
 
-
 enum {
 	LNK_SYNC_INI	= 0x0c30,/* 32 bit	Link Sync Cnt Init Value */
 	LNK_SYNC_VAL	= 0x0c34,/* 32 bit	Link Sync Cnt Current Value */
@@ -847,7 +846,6 @@ enum {
 	RX_GMF_RLEV	= 0x0c78,/* 32 bit	Rx GMAC FIFO Read Level */
 };
 
-
 /*	Q_BC			32 bit	Current Byte Counter */
 
 /* BMU Control Status Registers */
@@ -970,7 +968,6 @@ enum {
 	RB_RST_SET	= 1<<0,	/* Set   RAM Buf STM Reset */
 };
 
-
 /* Transmit GMAC FIFO (YUKON only) */
 enum {
 	TX_GMF_EA	= 0x0d40,/* 32 bit	Tx GMAC FIFO End Address */
@@ -1402,7 +1399,6 @@ enum {
 	PHY_M_AN_MSK	       = PHY_M_IS_AN_ERROR | PHY_M_IS_AN_COMPL,
 };
 
-
 /*****  PHY_MARV_EXT_CTRL	16 bit r/w	Ext. PHY Specific Ctrl *****/
 enum {
 	PHY_M_EC_ENA_BC_EXT = 1<<15, /* Enable Block Carr. Ext. (88E1111 only) */
@@ -1669,7 +1665,6 @@ enum {
 	GM_MIB_CNT_END	= 0x025C,	/* Last MIB counter */
 };
 
-
 /*
  * MIB Counters base address definitions (low word) -
  * use offset 4 for access to high word	(32 bit r/o)
@@ -1797,7 +1792,6 @@ enum {
 #define TX_IPG_JAM_DATA(x)	(((x)<<4)  & GM_TXPA_JAMDAT_MSK)
 #define TX_BACK_OFF_LIM(x)	((x) & GM_TXPA_BO_LIM_MSK)
 
-
 /*	GM_SERIAL_MODE			16 bit r/w	Serial Mode Register */
 enum {
 	GM_SMOD_DATABL_MSK	= 0x1f<<11, /* Bit 15..11:	Data Blinder (r/o) */
@@ -2078,7 +2072,6 @@ enum {						/* Bits 15.. 2:	reserved */
 	GMLC_RST_SET	= 1<<0,	/* Set   GMAC Link Reset */
 };
 
-
 /*	WOL_CTRL_STAT	16 bit	WOL Control/Status Reg */
 enum {
 	WOL_CTL_LINK_CHG_OCC		= 1<<15,
@@ -2099,7 +2092,6 @@ enum {
 	WOL_CTL_DIS_PATTERN_UNIT	= 1<<0,
 };
 
-
 /* Control flags */
 enum {
 	UDPTCP	= 1<<0,
