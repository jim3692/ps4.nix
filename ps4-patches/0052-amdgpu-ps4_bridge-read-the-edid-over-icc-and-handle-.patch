+static bool ps4_bridge_vic_supported(u8 vic)
+{
+	switch (vic) {
+	case 1 ... 6:
+	case 16 ... 21:
+	case 31 ... 34:
+	case 46 ... 49:
+	case 63:
+	case 64:
+	case 96:
+	case 97:
+	case 101:
+	case 102:
+		return true;
+	default:
+		return false;
+	}
+}
+
 enum drm_mode_status ps4_bridge_mode_valid(struct drm_connector *connector,
 				  const struct drm_display_mode *mode)
 {
-	int vic = drm_match_cea_mode(mode);
+	u8 vic = drm_match_cea_mode(mode);
 
-	if (!vic || (vic != 16 && vic != 4 && vic != 63)) {
+	if (mode->flags & DRM_MODE_FLAG_INTERLACE)
+		return MODE_NO_INTERLACE;
+	if (mode->clock > PS4_BRIDGE_MAX_CLOCK)
+		return MODE_CLOCK_HIGH;
+	if (!ps4_bridge_vic_supported(vic))
 		return MODE_BAD;
-	}
 	return MODE_OK;
 }
 
