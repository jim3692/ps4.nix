+static int ps4_bridge_edid_fetch(struct ps4_bridge *mn_bridge, u8 seq, u8 *out)
+{
+	struct i2c_cmdqueue *q = &mn_bridge->cq;
+	unsigned int i;
+	int ret;
+
+	cq_init(q, 4);
+	cq_writereg(q, AKESRST, 0xff);
+	cq_writereg(q, EDIDCTRL3, 0x88);
+	cq_wait_set(q, AKESTA, 0xa0);
+	cq_wait_clear(q, AKESTA, AKESTA_BUSY);
+	cq_writereg(q, EDIDCTRL4, 0x0a);
+	cq_writereg(q, EDIDCTRL0, seq);
+	cq_writereg(q, EDIDCTRL1, 0x00);
+	cq_writereg(q, EDIDCTRL2, 0xff);
+	cq_writereg(q, EDIDCTRL3, 0x82);
+	cq_wait_set(q, AKESTA, 0xa0);
+	cq_wait_clear(q, AKESTA, AKESTA_BUSY);
+	ret = cq_exec(q);
+	if (ret < 0)
+		return ret;
+
+	for (i = 0; i < 2; i++) {
+		cq_init(q, 4);
+		cq_read(q, i ? EDIDFIFO1 : EDIDFIFO0, EDID_LENGTH);
+		ret = cq_exec(q);
+		if (ret >= (int)(sizeof(q->reply) - sizeof(q->reply.databuf)) +
+			   EDID_REPLY_SKIP + EDID_LENGTH) {
+			memcpy(out + i * EDID_LENGTH,
+			       q->reply.databuf + EDID_REPLY_SKIP, EDID_LENGTH);
+			continue;
+		}
+		goto small_reads;
+	}
+	return 0;
+
+small_reads:
+	for (i = 0; i < 2 * EDID_LENGTH / 8; i++) {
+		cq_init(q, 4);
+		cq_read(q, i ? EDIDFIFO1 : EDIDFIFO0, 8);
+		ret = cq_exec(q);
+		if (ret < 0)
+			return ret;
+		memcpy(out + i * 8, q->reply.databuf + EDID_REPLY_SKIP, 8);
+	}
+	return 0;
+}
+
+static int ps4_bridge_read_edid_block_icc(void *data, u8 *buf,
+					  unsigned int block, size_t len)
+{
+	struct ps4_bridge *mn_bridge = data;
+	u8 seg[2 * EDID_LENGTH];
+	int ret;
+
+	if (!mn_bridge || len > EDID_LENGTH)
+		return -EINVAL;
+
+	mutex_lock(&mn_bridge->mutex);
+	ret = ps4_bridge_edid_fetch(mn_bridge, block / 2, seg);
+	mutex_unlock(&mn_bridge->mutex);
+	if (ret < 0)
+		return ret;
+
+	memcpy(buf, seg + (block % 2) * EDID_LENGTH, len);
+	return 0;
+}
+
+static int ps4_bridge_set_event_control(struct ps4_bridge *mn_bridge, u8 enable)
+{
+	struct i2c_cmdqueue *q = &mn_bridge->cq;
+	int ret;
+
+	mutex_lock(&mn_bridge->mutex);
+	cq_init(q, 4);
+	cq_cmd(q, 5, 4);
+	*q->p++ = enable;
+	ret = cq_exec(q);
+	mutex_unlock(&mn_bridge->mutex);
+	return ret < 0 ? ret : 0;
+}
+
+static bool ps4_bridge_edid_blocks_valid(const u8 *edid, unsigned int blocks)
+{
+	unsigned int block, i;
+	u8 sum;
+
+	for (block = 0; block < blocks; block++) {
+		sum = 0;
+		for (i = 0; i < EDID_LENGTH; i++)
+			sum += edid[block * EDID_LENGTH + i];
+		if (sum)
+			return false;
+	}
+	return true;
+}
+
+static void ps4_bridge_hdmi_event(void *ctx, u16 minor, const u8 *data,
+				  u16 length)
+{
+	struct ps4_bridge *mn_bridge = ctx;
+	const u8 *edid = data + PS4_BRIDGE_EVENT_HEADER_SIZE;
+	unsigned int blocks;
+	u16 edid_size;
+	u8 *copy;
+	u8 code;
+
+	if (length < PS4_BRIDGE_EVENT_HEADER_SIZE ||
+	    data[0] != PS4_BRIDGE_ICC_SERVICE)
+		return;
+
+	code = data[1];
+	edid_size = get_unaligned_le16(data + 2);
+	if (edid_size > length - PS4_BRIDGE_EVENT_HEADER_SIZE)
+		return;
+
+	switch (code) {
+	case PS4_BRIDGE_EVENT_UNPLUG:
+		mutex_lock(&mn_bridge->mutex);
+		kfree(mn_bridge->hdmi_edid);
+		mn_bridge->hdmi_edid = NULL;
+		mn_bridge->hdmi_edid_size = 0;
+		mn_bridge->hdmi_status = connector_status_disconnected;
+		mn_bridge->hdmi_event_seen = true;
+		mutex_unlock(&mn_bridge->mutex);
+		DRM_DEBUG_KMS("ps4_bridge: hdmi unplug\n");
+		break;
+	case PS4_BRIDGE_EVENT_PLUG:
+		blocks = edid_size / EDID_LENGTH;
+		if (!blocks || blocks > PS4_BRIDGE_EVENT_MAX_BLOCKS ||
+		    edid_size % EDID_LENGTH ||
+		    !ps4_bridge_edid_blocks_valid(edid, blocks)) {
+			DRM_ERROR("ps4_bridge: hdmi plug with a bad edid (%u bytes)\n",
+				  edid_size);
+			return;
+		}
+		copy = kmemdup(edid, edid_size, GFP_KERNEL);
+		if (!copy)
+			return;
+		mutex_lock(&mn_bridge->mutex);
+		kfree(mn_bridge->hdmi_edid);
+		mn_bridge->hdmi_edid = copy;
+		mn_bridge->hdmi_edid_size = edid_size;
+		mn_bridge->hdmi_status = connector_status_connected;
+		mn_bridge->hdmi_event_seen = true;
+		mutex_unlock(&mn_bridge->mutex);
+		DRM_DEBUG_KMS("ps4_bridge: hdmi plug, %u edid blocks\n", blocks);
+		break;
+	default:
+		DRM_DEBUG_KMS("ps4_bridge: hdmi event %u ignored\n", code);
+		return;
+	}
+
+	drm_kms_helper_connector_hotplug_event(mn_bridge->connector);
+}
+
+static void ps4_bridge_events_stop(void *data)
+{
+	struct ps4_bridge *mn_bridge = data;
+
+	if (!mn_bridge->hdmi_events)
+		return;
+	ps4_bridge_set_event_control(mn_bridge, 0);
+	bpcie_icc_unregister_event_handler(PS4_BRIDGE_ICC_SERVICE);
+	mn_bridge->hdmi_events = false;
+	kfree(mn_bridge->hdmi_edid);
+	mn_bridge->hdmi_edid = NULL;
+	mn_bridge->hdmi_edid_size = 0;
+}
+
+static void ps4_bridge_events_start(struct device *dev,
+				    struct ps4_bridge *mn_bridge)
+{
+	if (bpcie_status() <= 0)
+		return;
+	if (bpcie_icc_register_event_handler(PS4_BRIDGE_ICC_SERVICE,
+					     ps4_bridge_hdmi_event, mn_bridge))
+		return;
+	mn_bridge->hdmi_events = true;
+	mn_bridge->hdmi_status = connector_status_unknown;
+	if (devm_add_action_or_reset(dev, ps4_bridge_events_stop, mn_bridge))
+		return;
+	if (ps4_bridge_set_event_control(mn_bridge, 1))
+		DRM_ERROR("ps4_bridge: failed to enable hdmi events\n");
+}
