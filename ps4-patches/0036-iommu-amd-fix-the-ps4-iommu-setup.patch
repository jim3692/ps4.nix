From bb12e93d367b3cad2261bc90443ce2f1761b2400 Mon Sep 17 00:00:00 2001
From: Armandas Kvietkus <armandas.kvietkus@proton.me>
Date: Sun, 10 May 2026 20:02:37 +0200
Subject: [PATCH 036/124] iommu: amd: fix the ps4 iommu setup

Signed-off-by: Armandas Kvietkus <armandas.kvietkus@proton.me>
---
 drivers/iommu/amd/init.c  | 39 +++++++++++++++++++++++++++------------
 drivers/iommu/amd/iommu.c | 25 ++++++++++++++++++++++---
 2 files changed, 49 insertions(+), 15 deletions(-)

diff --git a/drivers/iommu/amd/init.c b/drivers/iommu/amd/init.c
index c872685cb73fdc213842db153fd4cb821bbbd31a..1f70325af0e81ea6281170a71b905af29b5c81e7 100644
--- a/drivers/iommu/amd/init.c
+++ b/drivers/iommu/amd/init.c
@@ -28,6 +28,7 @@
 #include <asm/x86_init.h>
 #include <asm/io_apic.h>
 #include <asm/irq_remapping.h>
+#include <asm/processor.h>
 #include <asm/set_memory.h>
 #include <asm/sev.h>
 
@@ -934,7 +935,6 @@ static int iommu_ga_log_enable(struct amd_iommu *iommu)
 	writel(0x00, iommu->mmio_base + MMIO_GA_HEAD_OFFSET);
 	writel(0x00, iommu->mmio_base + MMIO_GA_TAIL_OFFSET);
 
-
 	iommu_feature_enable(iommu, CONTROL_GAINT_EN);
 	iommu_feature_enable(iommu, CONTROL_GALOG_EN);
 
@@ -1455,7 +1455,6 @@ static int __init init_iommu_from_acpi(struct amd_iommu *iommu,
 	u32 ivhd_size;
 	int ret;
 
-
 	ret = add_early_maps();
 	if (ret)
 		return ret;
@@ -1480,7 +1479,6 @@ static int __init init_iommu_from_acpi(struct amd_iommu *iommu,
 
 	end += h->length;
 
-
 	while (p < end) {
 		e = (struct ivhd_entry *)p;
 		seg_id = pci_seg->id;
@@ -1963,10 +1961,19 @@ static int __init init_iommu_one_late(struct amd_iommu *iommu)
 
 	init_translation_status(iommu);
 	if (translation_pre_enabled(iommu) && !is_kdump_kernel()) {
-		iommu_disable(iommu);
-		clear_translation_pre_enabled(iommu);
-		pr_warn("Translation was enabled for IOMMU:%d but we are not in kdump mode\n",
-			iommu->index);
+#ifdef CONFIG_X86_PS4_BAIKAL
+		if (boot_cpu_data.x86_vendor == X86_VENDOR_AMD &&
+		    boot_cpu_data.x86 == 0x16) {
+			pr_info("AMD-Vi: PS4 Baikal: IOMMU:%d pre-enabled, preserving state\n",
+				iommu->index);
+		} else
+#endif
+		{
+			iommu_disable(iommu);
+			clear_translation_pre_enabled(iommu);
+			pr_warn("Translation was enabled for IOMMU:%d but we are not in kdump mode\n",
+				iommu->index);
+		}
 	}
 	if (amd_iommu_pre_enabled)
 		amd_iommu_pre_enabled = translation_pre_enabled(iommu);
@@ -2385,7 +2392,6 @@ union intcapxt {
 	};
 } __attribute__ ((packed));
 
-
 static struct irq_chip intcapxt_controller;
 
 static int intcapxt_irqdomain_activate(struct irq_domain *domain,
@@ -2399,7 +2405,6 @@ static void intcapxt_irqdomain_deactivate(struct irq_domain *domain,
 {
 }
 
-
 static int intcapxt_irqdomain_alloc(struct irq_domain *domain, unsigned int virq,
 				    unsigned int nr_irqs, void *arg)
 {
@@ -2431,7 +2436,6 @@ static void intcapxt_irqdomain_free(struct irq_domain *domain, unsigned int virq
 	irq_domain_free_irqs_top(domain, virq, nr_irqs);
 }
 
-
 static void intcapxt_unmask_irq(struct irq_data *irqd)
 {
 	struct amd_iommu *iommu = irqd->chip_data;
@@ -2454,7 +2458,6 @@ static void intcapxt_mask_irq(struct irq_data *irqd)
 	writeq(0, iommu->mmio_base + irqd->hwirq);
 }
 
-
 static int intcapxt_set_affinity(struct irq_data *irqd,
 				 const struct cpumask *mask, bool force)
 {
@@ -2490,7 +2493,6 @@ static const struct irq_domain_ops intcapxt_domain_ops = {
 	.deactivate		= intcapxt_irqdomain_deactivate,
 };
 
-
 static struct irq_domain *iommu_irqdomain;
 
 static struct irq_domain *iommu_get_irqdomain(void)
@@ -3311,6 +3313,13 @@ static int __init early_amd_iommu_init(void)
 	}
 
 	/* Disable any previously enabled IOMMUs */
+#ifdef CONFIG_X86_PS4_BAIKAL
+	if (amd_iommu_pre_enabled &&
+	    boot_cpu_data.x86_vendor == X86_VENDOR_AMD &&
+	    boot_cpu_data.x86 == 0x16) {
+		pr_info("AMD-Vi: PS4 Baikal: keeping IOMMU enabled to preserve IR tables\n");
+	} else
+#endif
 	if (!is_kdump_kernel() || amd_iommu_disabled)
 		disable_iommus();
 
@@ -3705,6 +3714,12 @@ void __init amd_iommu_detect(void)
 {
 	int ret;
 
+#ifdef CONFIG_X86_PS4_BAIKAL
+	if (boot_cpu_data.x86_vendor == X86_VENDOR_AMD &&
+	    boot_cpu_data.x86 == 0x16)
+		goto disable_snp;
+#endif
+
 	if (no_iommu || (iommu_detected && !gart_iommu_aperture))
 		goto disable_snp;
 
diff --git a/drivers/iommu/amd/iommu.c b/drivers/iommu/amd/iommu.c
index 93c84de8ac8b058d85de2b09257e76ec74cfbeca..84b9f41a91355d1e5ec9aca036b97aa032eefaf2 100644
--- a/drivers/iommu/amd/iommu.c
+++ b/drivers/iommu/amd/iommu.c
@@ -3162,6 +3162,21 @@ static bool amd_iommu_is_attach_deferred(struct device *dev)
 	return dev_data->defer_attach;
 }
 
+#ifdef CONFIG_X86_PS4_BAIKAL
+static bool amd_iommu_ps4_baikal_force_identity(struct device *dev)
+{
+	struct pci_dev *pdev;
+
+	if (!dev_is_pci(dev))
+		return false;
+
+	pdev = to_pci_dev(dev);
+	return pdev->vendor == PCI_VENDOR_ID_SONY &&
+	       pdev->device >= PCI_DEVICE_ID_SONY_BAIKAL_ACPI &&
+	       pdev->device <= PCI_DEVICE_ID_SONY_BAIKAL_XHCI;
+}
+#endif
+
 static int amd_iommu_def_domain_type(struct device *dev)
 {
 	struct iommu_dev_data *dev_data;
@@ -3174,6 +3189,13 @@ static int amd_iommu_def_domain_type(struct device *dev)
 	if (dev_is_pci(dev) && to_pci_dev(dev)->untrusted)
 		return IOMMU_DOMAIN_DMA;
 
+#ifdef CONFIG_X86_PS4_BAIKAL
+	if (amd_iommu_ps4_baikal_force_identity(dev) &&
+	    !cc_platform_has(CC_ATTR_MEM_ENCRYPT) &&
+	    !amd_iommu_snp_en)
+		return IOMMU_DOMAIN_IDENTITY;
+#endif
+
 	/*
 	 * Do not identity map IOMMUv2 capable devices when:
 	 *  - memory encryption is active, because some of those devices
@@ -3980,12 +4002,9 @@ static int irq_remapping_select(struct irq_domain *d, struct irq_fwspec *fwspec,
 		devid = get_ioapic_devid(fwspec->param[0]);
 	else if (x86_fwspec_is_hpet(fwspec))
 		devid = get_hpet_devid(fwspec->param[0]);
-	else if(x86_fwspec_is_aeolia(fwspec))
-		devid = fwspec->param[0];
 
 	if (devid < 0)
 		return 0;
-	pr_err("Remapping Selected: %x\n", devid);
 	iommu = __rlookup_amd_iommu((devid >> 16), (devid & 0xffff));
 
 	return iommu && iommu->ir_domain == d;
