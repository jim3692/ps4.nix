-	[DMI_CHASSIS_ASSET_TAG]  = "",
-	[DMI_CHASSIS_SERIAL]     = "",
-	[DMI_CHASSIS_VERSION]    = ""
+	[DMI_BIOS_VENDOR]           = "Sony Interactive Entertainment Inc.",
+	[DMI_BIOS_VERSION]          = "1.00",
+	[DMI_BIOS_DATE]             = "11/15/2013",
+	[DMI_BIOS_RELEASE]          = "1.0",
