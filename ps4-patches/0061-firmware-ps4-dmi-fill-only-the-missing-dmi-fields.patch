 void __init ps4_dmi_populate(const char *ident[DMI_STRING_MAX])
 {
 	int i;
 
-	pr_info("ps4_dmi: injecting generic PS4 fallback DMI strings\n");
+	pr_info("ps4_dmi: filling missing DMI fields with PS4 defaults\n");
 
 	for (i = 0; i < DMI_STRING_MAX; i++) {
-		if (ps4_strings[i])
+		if (ps4_strings[i] && !ident[i])
 			ident[i] = ps4_strings[i];
 	}
 }
diff --git a/drivers/firmware/ps4-dmi.h b/drivers/firmware/ps4-dmi.h
index 88abaf6dcb48545dbb722fb71b5e1372d7124bcb..e0739cafa654fccc3937a1c62d2fe64824d0a5f0 100644
--- a/drivers/firmware/ps4-dmi.h
+++ b/drivers/firmware/ps4-dmi.h
@@ -4,17 +4,10 @@
 
 #include <linux/dmi.h>
 #include <linux/init.h>
-#include <linux/types.h>
 
 #ifdef CONFIG_PS4_DMI_SPOOF
-bool __init ps4_dmi_is_ps4(void);
 void __init ps4_dmi_populate(const char *ident[DMI_STRING_MAX]);
 #else
-static inline bool ps4_dmi_is_ps4(void)
-{
-	return false;
-}
-
 static inline void ps4_dmi_populate(const char *ident[DMI_STRING_MAX])
 {
 }
