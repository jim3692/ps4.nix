From 9a9242b5ff8b7a38da16bb32ec746791a02b7af5 Mon Sep 17 00:00:00 2001
From: Armandas Kvietkus <armandas.kvietkus@proton.me>
Date: Fri, 6 Nov 2026 21:53:08 +0100
Subject: [PATCH 075/124] x86: ps4: calibrate: measure the tsc against the
 baikal emc timer

Signed-off-by: Armandas Kvietkus <armandas.kvietkus@proton.me>
---
 arch/x86/include/asm/ps4.h        |  3 ++
 arch/x86/platform/ps4/calibrate.c | 53 +++++++++++++++++--------------
 2 files changed, 33 insertions(+), 23 deletions(-)

diff --git a/arch/x86/include/asm/ps4.h b/arch/x86/include/asm/ps4.h
index 537b776b5e1cc5a49921fa88df78f831ea5c5ae1..87614e65ccdf949e1caad7658cfd800b09b2d14c 100644
--- a/arch/x86/include/asm/ps4.h
+++ b/arch/x86/include/asm/ps4.h
@@ -20,6 +20,9 @@
 
 #define EMC_TIMER_BASE 0xd0281000
 #define EMC_TIMER_VALUE 0x28
+#define EMC_TIMER_HZ 32768
+#define EMC_TIMER_BAIKAL_OFFSET 0x9000
+#define EMC_TIMER_BAIKAL_VALUE 0x18
 
 extern unsigned long ps4_calibrate_tsc(void);
 
diff --git a/arch/x86/platform/ps4/calibrate.c b/arch/x86/platform/ps4/calibrate.c
index 9862bb8b5ba4174ec6c071cb8894eade49c76d36..de85cc2e93f3881309c2103226bd3954d7e1a66e 100644
--- a/arch/x86/platform/ps4/calibrate.c
+++ b/arch/x86/platform/ps4/calibrate.c
@@ -12,6 +12,7 @@
 #include <linux/jiffies.h>
 #include <asm/io.h>
 #include <asm/msr.h>
+#include <asm/pci-direct.h>
 #include <asm/ps4.h>
 #include <asm/delay.h>
 #include <asm/apic.h>
@@ -22,6 +23,7 @@
  * and the LAPIC timer are based on the core clock frequency and thus can be
  * calibrated together. */
 static void __iomem *emc_timer = NULL;
+static unsigned int emc_timer_value __initdata;
 
 static __init inline u32 emctimer_read32(unsigned int reg)
 {
@@ -38,9 +40,9 @@ static __init bool emctimer_read(u32 *value)
 	u32 t1, t2;
 	int tries;
 
-	t1 = emctimer_read32(EMC_TIMER_VALUE);
+	t1 = emctimer_read32(emc_timer_value);
 	for (tries = 0; tries < 10000; tries++) {
-		t2 = emctimer_read32(EMC_TIMER_VALUE);
+		t2 = emctimer_read32(emc_timer_value);
 		if (t1 == t2) {
 			*value = t1;
 			return true;
@@ -58,23 +60,33 @@ static __init unsigned long ps4_measure_tsc_freq(void)
 	u32 now;
 	u32 t1, t2;
 	u64 tsc1, tsc2;
-
-	// This is part of the Aeolia pcie device, but it's too early to
-	// do this in a driver.
-	emc_timer = early_ioremap(EMC_TIMER_BASE, 0x100);
+	bool baikal = ps4_is_baikal();
+	u32 ticks = baikal ? 8192 : 1024;
+
+	if (baikal) {
+		u32 bar4 = read_pci_config(0, 0x14, 4, PCI_BASE_ADDRESS_4) &
+			   PCI_BASE_ADDRESS_MEM_MASK;
+
+		emc_timer = early_ioremap(bar4 + EMC_TIMER_BAIKAL_OFFSET, 0x100);
+		emc_timer_value = EMC_TIMER_BAIKAL_VALUE;
+	} else {
+		emc_timer = early_ioremap(EMC_TIMER_BASE, 0x100);
+		emc_timer_value = EMC_TIMER_VALUE;
+	}
 	if (!emc_timer)
 		goto fail;
 
-	// reset/start the timer
-	emctimer_write32(0x84, emctimer_read32(0x84) & (~0x01));
-	{
-		u64 reset_deadline = rdtsc() + (PS4_PRO_TSC_FREQ / 1000000) * 300;
+	if (!baikal) {
+		emctimer_write32(0x84, emctimer_read32(0x84) & (~0x01));
+		{
+			u64 reset_deadline = rdtsc() + (PS4_PRO_TSC_FREQ / 1000000) * 300;
 
-		while (rdtsc() < reset_deadline)
-			cpu_relax();
+			while (rdtsc() < reset_deadline)
+				cpu_relax();
+		}
+		emctimer_write32(0x00, emctimer_read32(0x00) | 0x01);
+		emctimer_write32(0x84, emctimer_read32(0x84) | 0x01);
 	}
-	emctimer_write32(0x00, emctimer_read32(0x00) | 0x01);
-	emctimer_write32(0x84, emctimer_read32(0x84) | 0x01);
 
 	if (!emctimer_read(&t1)) {
 		pr_warn("EMC timer did not stabilize.\n");
@@ -112,27 +124,22 @@ static __init unsigned long ps4_measure_tsc_freq(void)
 	} while (t2 == t1);
 	tsc1 = rdtsc();
 
-	// Wait for 1024 ticks to elapse (31.25ms)
-	// We don't need to wait very long, as we are looking for transitions.
-	// At this value, a TSC uncertainty of ~50 ticks corresponds to 1ppm of
-	// clock accuracy.
-	u64 deadline = rdtsc() + PS4_DEFAULT_TSC_FREQ / 5;
+	u64 deadline = rdtsc() + (u64)PS4_PRO_TSC_FREQ * ticks / EMC_TIMER_HZ * 2;
 	for (;;) {
 		if (!emctimer_read(&now)) {
 			pr_warn("EMC timer did not stabilize.\n");
 			goto fail;
 		}
-		if ((now - t2) >= 1024)
+		if ((now - t2) >= ticks)
 			break;
 		if (rdtsc() > deadline) {
-			pr_warn("EMC timer 1024-tick wait timed out.\n");
+			pr_warn("EMC timer tick wait timed out.\n");
 			goto fail;
 		}
 	}
 	tsc2 = rdtsc();
 
-	// TSC rate is 32 times the elapsed time
-	ret = (tsc2 - tsc1) * 32;
+	ret = (tsc2 - tsc1) * (EMC_TIMER_HZ / ticks);
 
 	pr_info("Calibrated TSC frequency: %ld kHz\n", ret);
 fail:
