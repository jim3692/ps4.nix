+
+#define    UNREACH_ABLE 25
+#define TDLS_REASON_CODE_UNREACHABLE  25
+#define TDLS_REASON_CODE_UNSPECIFIED  26
+
+#define WLAN_REASON_TDLS_TEARDOWN_UNREACHABLE 25
+#define WLAN_REASON_TDLS_TEARDOWN_UNSPECIFIED 26
+
