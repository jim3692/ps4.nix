+	QM_DBG_CNT_27,
+	QM_DBG_CNT_28,
+	QM_DBG_CNT_29,
+	QM_DBG_CNT_30,
+	QM_DBG_CNT_31,
+	QM_DBG_CNT_NUM
+};
+
+/* Used for MAC TX */
+typedef enum _ENUM_MAC_TX_QUEUE_INDEX_T {
