+		case TEST_PS_UPDATE_BEACON:
+			bssUpdateBeaconContent(prAdapter, ucOpt0 /*networktype */);
+			break;
+
+		default:
+			break;
+		}
+	} else {
+		switch (ucIndex) {
+
+		case TEST_PS_MAGIC:
+			g_au4SwCr[1] = 0x88660011;
+			break;
+
+		}
+	}
+}
