+VOID nicTxDirectClearBssAbsentQ(IN P_ADAPTER_T prAdapter, UINT_8 ucBssIndex)
+{
+	P_GLUE_INFO_T prGlueInfo = prAdapter->prGlueInfo;
+	QUE_T rNeedToFreeQue;
