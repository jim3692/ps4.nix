+/*----------------------------------------------------------------------------*/
+VOID wlanoidClearTimeoutCheck(IN P_ADAPTER_T prAdapter)
+{
+	ASSERT(prAdapter);
+
+	cnmTimerStopTimer(prAdapter, &(prAdapter->rOidTimeoutTimer));
+}
