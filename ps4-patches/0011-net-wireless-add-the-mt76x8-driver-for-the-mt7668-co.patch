+	/* g_rPfmuTag2 = prPfumTagRead->ru4TxBfPFMUTag2; */
+
+	kalOidComplete(prGlueInfo, prCmdInfo->fgSetQuery, u4QueryInfoLen, WLAN_STATUS_SUCCESS);
