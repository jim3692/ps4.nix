+wlanoidSetCSUMOffload(IN P_ADAPTER_T prAdapter,
+		      IN PVOID pvSetBuffer, IN UINT_32 u4SetBufferLen, OUT PUINT_32 pu4SetInfoLen)
+{
+	UINT_32 u4CSUMFlags;
+	CMD_BASIC_CONFIG_T rCmdBasicConfig;
