+			 NETWORK_TYPE_BOW) {
+			/* ToDo:: Nothing */
+		}
+#endif
+		else {
+			DBGLOG(RX, ERROR, "EVENT_ID_BSS_BEACON_TIMEOUT: (ucBssIndex = %d)\n",
