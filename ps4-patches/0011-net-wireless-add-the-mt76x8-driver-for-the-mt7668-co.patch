+	ENUM_DBDC_BN_T eDBDCBand;
+} MSG_CH_REQ_T, *P_MSG_CH_REQ_T;
+
+typedef struct _MSG_CH_ABORT_T {
+	MSG_HDR_T rMsgHdr;	/* Must be the first member */
