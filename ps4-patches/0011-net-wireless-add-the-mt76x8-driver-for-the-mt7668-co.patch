+*
+* \return (none)
+*/
+/*----------------------------------------------------------------------------*/
+VOID glBusFreeIrq(PVOID pvData, PVOID pvCookie)
+{
+	struct net_device *prDev = (struct net_device *)pvData;
+
+	if (!prDev) {
+		pr_info("Invalid net_device context.\n");
+		return;
+	}
+
+	if (prDev->irq) {
+		disable_irq(prDev->irq);
+		free_irq(prDev->irq, pvCookie);
+		prDev->irq = 0;
+	}
+
+	busFreeIrq();
+}
