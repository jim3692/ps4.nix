+	struct mt66xx_chip_info *prChipInfo; \
+	if (!_prAdapter->chip_info) \
+		ASSERT(0); \
+	prChipInfo = _prAdapter->chip_info; \
+	HAL_MCR_RD(_prAdapter, prChipInfo->sw_sync0, &_u4Result); \
+} while (0)
