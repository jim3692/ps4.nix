+					  (PUINT_8) prBcnFrame->aucInfoElem,
+					  (prBcnMsduInfo->u2FrameLength - OFFSET_OF(WLAN_BEACON_FRAME_T, aucInfoElem)));
+#endif
+	} while (FALSE);
+
+	return rWlanStatus;
+}				/* p2pFuncBeaconUpdate */
