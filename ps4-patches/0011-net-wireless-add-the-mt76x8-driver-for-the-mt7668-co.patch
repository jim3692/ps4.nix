+
+	DBGLOG(BSS, INFO, "Current Client List didn't contain that STA_RECORD_T["
+	       MACSTR "] before removing.\n", MAC2STR(pucMac));
+
+	bssCheckClientList(prAdapter, prBssInfo);
+
+	return NULL;
+}
