+	case FIXED_RATE_6M:
+		if ((*pucDesiredPhyTypeSet) & PHY_TYPE_BIT_ERP)
+			*pucDesiredPhyTypeSet = PHY_TYPE_BIT_ERP;
+		else if ((*pucDesiredPhyTypeSet) & PHY_TYPE_BIT_OFDM)
+			*pucDesiredPhyTypeSet = PHY_TYPE_BIT_OFDM;
