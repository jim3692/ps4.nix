+		/* Process complete event */
+		halRxUSBProcessEventDataComplete(prAdapter, &prHifInfo->rRxEventCompleteQ,
+			&prHifInfo->rRxEventFreeQ, USB_RX_EVENT_RFB_RSV_CNT);
+		halRxUSBReceiveEvent(prAdapter, FALSE);
+	}
