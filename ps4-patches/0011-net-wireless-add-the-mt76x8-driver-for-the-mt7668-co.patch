+static BOOLEAN glIsReadClearReg(UINT_32 u4Address)
+{
+	switch (u4Address) {
+	case MCR_WHISR:
+	case MCR_WASR:
+	case MCR_D2HRM0R:
+	case MCR_D2HRM1R:
+	case MCR_WTQCR0:
+	case MCR_WTQCR1:
+	case MCR_WTQCR2:
+	case MCR_WTQCR3:
+	case MCR_WTQCR4:
+	case MCR_WTQCR5:
+	case MCR_WTQCR6:
+	case MCR_WTQCR7:
+		return TRUE;
+
+	default:
+		return FALSE;
+	}
+}
