+BOOLEAN p2pFuncIsAPMode(IN P_P2P_CONNECTION_SETTINGS_T prP2pConnSettings)
+{
+	if (prP2pConnSettings) {
+		if (prP2pConnSettings->fgIsWPSMode == 1)
