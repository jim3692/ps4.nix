+	if (unlikely(nla_put(skb, MTK_ATTR_AGPS_IFNAME, 5, prGlueInfo->prDevHandler->name) < 0))
+		goto nla_put_failure;
+
+	cfg80211_testmode_event(skb, GFP_KERNEL);
+	return TRUE;
+
+nla_put_failure:
+	kfree_skb(skb);
+	return FALSE;
