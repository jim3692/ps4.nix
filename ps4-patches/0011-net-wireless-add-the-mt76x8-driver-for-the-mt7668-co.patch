+					rWifiHotlistCmd.ap[i].low = nla_get_u32(attr[k]);
+					len_aplist += NLA_ALIGN(attr[k]->nla_len);
+					break;
+				case GSCAN_ATTRIBUTE_RSSI_HIGH:
