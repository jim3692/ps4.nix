+			    &rRfATInfo,	/* pvInfoBuf */
+			    sizeof(rRfATInfo),	/* u4InfoBufLen */
+			    FALSE,	/* fgRead */
+			    FALSE,	/* fgWaitResp */
+			    TRUE,	/* fgCmd */
+			    &u4BufLen);	/* pu4QryInfoLen */
+
+	if (i4Status != WLAN_STATUS_SUCCESS)
