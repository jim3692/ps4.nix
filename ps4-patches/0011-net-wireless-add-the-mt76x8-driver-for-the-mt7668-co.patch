+
+	DBGLOG(INIT, INFO, "MT6632 : QA_AGENT HQA_ReadBulkEEPROM\n");
+
+	memcpy(&Offset, HqaCmdFrame->Data + 2 * 0, 2);
+	Offset = ntohs(Offset);
