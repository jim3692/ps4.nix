+		prRssi = (PARAM_RSSI *) prCmdInfo->pvInformationBuffer;
+
+		kalMemCopy(prRssi, &rRssi, sizeof(PARAM_RSSI));
+		u4QueryInfoLen = sizeof(PARAM_RSSI);
