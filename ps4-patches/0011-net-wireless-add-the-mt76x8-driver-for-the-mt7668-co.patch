+
+OUT BOOLEAN halUmacInfoGetMiscStatus(IN P_ADAPTER_T prAdapter, IN P_UMAC_STAT2_GET_T pUmacStat2Get)
+{
+	pUmacStat2Get->u2PleRevPgHif0Group0 =
