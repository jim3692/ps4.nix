+	P_MSG_P2P_BEACON_UPDATE_T prP2pBcnUpdateMsg = (P_MSG_P2P_BEACON_UPDATE_T) NULL;
+	PUINT_8 pucBuffer = (PUINT_8) NULL;
+	UINT_8 ucRoleIdx = 0;
+	UINT_32 u4Len = 0;
+
+	do {
+		if ((wiphy == NULL) || (info == NULL))
