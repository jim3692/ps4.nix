+			rateGetDataRatesFromRateSet(prP2pBssInfo->u2OperationalRateSet,
+					    prP2pBssInfo->u2BSSBasicRateSet,
+					    prP2pBssInfo->aucAllSupportedRates, &prP2pBssInfo->ucAllSupportedRatesLen);
