+
+	i4BytesWritten += kalScnprintf(pcCommand + i4BytesWritten, i4TotalLen - i4BytesWritten,
+		"%-20s%s%d\n", "Inst RSSI IB R3", " = ",
+		htonl(g_HqaRxStat.InstRssiIBR3));
+
+	i4BytesWritten += kalScnprintf(pcCommand + i4BytesWritten, i4TotalLen - i4BytesWritten,
+		"%-20s%s%d\n", "Inst RSSI WB R3", " = ",
