+
+	/* DbgPrint("QM:Event -RxBa\n"); */
+
+	prEventRxDelBa = (P_EVENT_RX_DELBA_T) (prEvent->aucBuffer);
+	prStaRec = QM_GET_STA_REC_PTR_FROM_INDEX(prAdapter, prEventRxDelBa->ucStaRecIdx);
+
+	if (!prStaRec)
+		/* Invalid STA_REC index, discard the event packet */
