+/*----------------------------------------------------------------------------*/
+/*!
+* \brief
+*
+* \param[in]
+*
+* \return none
+*/
+/*----------------------------------------------------------------------------*/
+P_STA_RECORD_T cnmGetStaRecByIndex(P_ADAPTER_T prAdapter, UINT_8 ucIndex)
+{
+	P_STA_RECORD_T prStaRec;
+
+	ASSERT(prAdapter);
+
+	prStaRec = (ucIndex < CFG_STA_REC_NUM) ? &prAdapter->arStaRec[ucIndex] : NULL;
+
+	if (prStaRec && prStaRec->fgIsInUse == FALSE)
+		prStaRec = NULL;
+
+	return prStaRec;
+}
