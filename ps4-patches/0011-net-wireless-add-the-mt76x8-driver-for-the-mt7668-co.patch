+#define RX_VT_CH_BW_IN_NON_HT_CBW40    BIT(20)
+#define RX_VT_CH_BW_IN_NON_HT_CBW80    BIT(21)
+#define RX_VT_CH_BW_IN_NON_HT_CBW160   BITS(20, 21)
