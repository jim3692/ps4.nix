+		*pucSupMcs32 = 0;
+		*pu2HtCapInfo = 0;
+		break;
+
+	case FIXED_RATE_11M:
+		*pucDesiredPhyTypeSet = PHY_TYPE_BIT_HR_DSSS;
+		*pu2DesiredNonHTRateSet = RATE_SET_BIT_11M;
+		*pu2BSSBasicRateSet = RATE_SET_BIT_11M;
+		*pucMcsSet = 0;
+		*pucSupMcs32 = 0;
+		*pu2HtCapInfo = 0;
+		break;
