+/*----------------------------------------------------------------------------*/
+/*!
+* @brief This utility function is used to indicate PM that
+*        a BSS has been disconnected
+*
+* @param prAdapter          Pointer of ADAPTER_T
+*        ucBssIndex         Index of BSS-INFO
+*
+* @retval -
+*/
+/*----------------------------------------------------------------------------*/
