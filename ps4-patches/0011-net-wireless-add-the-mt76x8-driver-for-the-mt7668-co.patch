+	WIFI_SUBCMD_SET_COUNTRY_CODE,					 /* 0x0005 */
+	/* Add more sub commands here */
+
+} WIFI_SUB_COMMAND;
+
+typedef enum {
+	GSCAN_SUBCMD_GET_CAPABILITIES = ANDROID_NL80211_SUBCMD_GSCAN_RANGE_START,
+
