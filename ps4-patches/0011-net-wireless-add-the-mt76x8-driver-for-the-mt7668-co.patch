+	halRxUSBProcessEventDataComplete(prAdapter, &prHifInfo->rRxDataCompleteQ,
+		&prHifInfo->rRxDataFreeQ, USB_RX_DATA_RFB_RSV_CNT);
+	halRxUSBReceiveData(prAdapter);
