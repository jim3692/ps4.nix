+/* RX Vector, 3rd Cycle */
+#define RX_VT_PART_AID_MASK        BITS(3, 11)
+#define RX_VT_PART_AID_OFFSET      3
+#define RX_VT_AID_0_MASK           BITS(3, 6) /* VHT_SIG_A1[B13:B16] */
+#define RX_VT_AID_0_OFFSET         3
