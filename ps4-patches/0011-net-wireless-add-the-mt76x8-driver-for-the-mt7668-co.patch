+typedef struct _DEVICE_TYPE_T {
+	UINT_16 u2CategoryId;	/* Category ID */
+	UINT_8 aucOui[4];	/* OUI */
+	UINT_16 u2SubCategoryId;	/* Sub Category ID */
+} __KAL_ATTRIB_PACKED__ DEVICE_TYPE_T, *P_DEVICE_TYPE_T;
+#endif
