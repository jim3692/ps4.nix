+	ASSERT(prAdapter);
+
+	prBowFsmInfo = &(prAdapter->rWifiVar.rBowFsmInfo);
+	prBowBssInfo = GET_BSS_INFO_BY_INDEX(prAdapter, prBowFsmInfo->ucBssIndex);
