+#define WFD_OUI_TYPE_LEN                            4
+
+/* == OFFSET_OF(IE_P2P_T,*/
+/*aucP2PAttributes[0]) */
+#define WFD_IE_OUI_HDR                              (ELEM_HDR_LEN + WFD_OUI_TYPE_LEN)
