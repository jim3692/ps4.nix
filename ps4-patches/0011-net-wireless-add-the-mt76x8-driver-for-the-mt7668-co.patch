+				   TRUE,
+				   FALSE,
+				   TRUE,
+				   NULL,
+				   nicOidCmdTimeoutCommon,
+				   sizeof(CMD_BASIC_CONFIG_T),
+				   (PUINT_8) &rCmdBasicConfig, pvSetBuffer, u4SetBufferLen);
