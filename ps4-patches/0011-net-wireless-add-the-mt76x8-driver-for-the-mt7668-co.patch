+* \param[in] data   Pointer to the private data structure.
+*
+* \return number of characters write from User Space.
+*/
+/*----------------------------------------------------------------------------*/
+static int procTxStatisticsWrite(struct file *file, const char *buffer, unsigned long count, void *data)
