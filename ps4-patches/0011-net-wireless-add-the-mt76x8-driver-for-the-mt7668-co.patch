+
+	prTxCtrl->rTc.au4MaxNumOfPage[TC5_INDEX] = NIC_TX_INIT_PAGE_COUNT_TC5;
+	prTxCtrl->rTc.au4FreePageCount[TC5_INDEX] = NIC_TX_INIT_PAGE_COUNT_TC5;
+
+	/* Buffer count */
+	for (ucIdx = TC0_INDEX; ucIdx < TC_NUM; ucIdx++) {
