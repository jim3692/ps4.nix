+*/
+/*----------------------------------------------------------------------------*/
+INT_32 MT_ATESetTxPower0(struct net_device *prNetDev, UINT_32 u4TxPower0)
+{
+	UINT_32 u4BufLen = 0;
+	INT_32 i4Status;
+	P_GLUE_INFO_T prGlueInfo = NULL;
+	PARAM_MTK_WIFI_TEST_STRUCT_T rRfATInfo;
