+WLAN_STATUS
+nicConfigPowerSaveWowProfile(IN P_ADAPTER_T prAdapter, UINT_8 ucBssIndex, PARAM_POWER_MODE ePwrMode,
+	BOOLEAN fgEnCmdEvent, BOOLEAN fgSuspend) {
+
+	CMD_PS_PROFILE_T rPowerSaveMode;
