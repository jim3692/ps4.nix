+static BOOL priv_driver_get_ldpc_info(IN P_PARAM_TX_CONFIG_T prWtblTxConfig)
+{
+	if (!prWtblTxConfig)
+		return FALSE;
+
+	if (prWtblTxConfig->fgIsVHT)
+		return prWtblTxConfig->fgVhtLDPC;
+	else
+		return prWtblTxConfig->fgLDPC;
+}
