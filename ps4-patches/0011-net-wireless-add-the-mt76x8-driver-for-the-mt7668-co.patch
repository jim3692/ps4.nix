+		if (prStaRec->ucStaState == STA_STATE_3) {
+			/* P_MSG_AIS_ABORT_T prAisAbortMsg; */
+
+			/* NOTE(Kevin): Change state immediately to avoid starvation of
+			 * MSG buffer because of too many deauth frames before changing
+			 * the STA state.
