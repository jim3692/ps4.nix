+	P_STA_RECORD_T prCurrStaRec;
+
+	ASSERT(prBssInfo);
+
+	prClientList = &prBssInfo->rStaRecOfClientList;
+
+	LINK_FOR_EACH_ENTRY(prCurrStaRec, prClientList, rLinkEntry, STA_RECORD_T) {
