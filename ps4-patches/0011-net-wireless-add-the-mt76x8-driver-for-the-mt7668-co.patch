+
+	if (HAL_IS_RX_DONE_INTR(u4RegValue))
+		*pu4IntStatus |= WHISR_RX0_DONE_INT;
+
+	if (HAL_IS_TX_DONE_INTR(u4RegValue))
+		*pu4IntStatus |= WHISR_TX_DONE_INT;
+
+	/* clear interrupt */
+	HAL_MCR_WR(prAdapter, WPDMA_INT_STA, u4RegValue);
+
+}
+#endif
