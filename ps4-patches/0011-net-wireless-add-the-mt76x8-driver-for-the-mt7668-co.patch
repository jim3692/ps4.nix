+/*! \file   nic_tx.h
+*    \brief  Functions that provide TX operation in NIC's point of view.
+*
+*    This file provides TX functions which are responsible for both Hardware and
+*    Software Resource Management and keep their Synchronization.
+*
+*/
+
+
+#ifndef _NIC_TX_H
+#define _NIC_TX_H
+
