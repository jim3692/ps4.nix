+/*----------------------------------------------------------------------------*/
+VOID
+kalIndicateMgmtTxStatus(IN P_GLUE_INFO_T prGlueInfo,
+			IN UINT_64 u8Cookie, IN BOOLEAN fgIsAck, IN PUINT_8 pucFrameBuf, IN UINT_32 u4FrameLen)
+{
+
+	do {
