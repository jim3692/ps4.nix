+					len_aplist += NLA_ALIGN(attr[k]->nla_len);
+					break;
+				}
+			}
+		}
+		if (((i + 1) % 4 == 0) || (i == rWifiHotlistCmd.num_ap - 1))
+			DBGLOG(REQ, TRACE, "ap[%d], len_aplist=%d\n", i, len_aplist);
+		else
+			DBGLOG(REQ, TRACE, "ap[%d], len_aplist=%d\t", i, len_aplist);
