+*                            P U B L I C   D A T A
+********************************************************************************
+*/
+
+typedef struct _BOW_TABLE_T {
+	UINT_8 ucAcquireID;
+	BOOLEAN fgIsValid;
+	ENUM_BOW_DEVICE_STATE eState;
+	UINT_8 aucPeerAddress[6];
+	/* UINT_8                      ucRole; */
+	/* UINT_8                      ucChannelNum; */
+	UINT_16 u2Reserved;
+} BOW_TABLE_T, *P_BOW_TABLE_T;
+
+typedef WLAN_STATUS(*PFN_BOW_CMD_HANDLE) (P_ADAPTER_T, P_AMPC_COMMAND);
+
+typedef struct _BOW_CMD_T {
+	UINT_8 uCmdID;
