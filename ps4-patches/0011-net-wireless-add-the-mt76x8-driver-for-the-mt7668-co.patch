+BOOLEAN wlanProcessTxFrame(IN P_ADAPTER_T prAdapter, IN P_NATIVE_PACKET prPacket)
+{
+	UINT_32 u4SysTime;
+	UINT_8 ucMacHeaderLen;
+	TX_PACKET_INFO rTxPacketInfo;
+	struct mt66xx_chip_info *prChipInfo;
+
+	ASSERT(prAdapter);
+	ASSERT(prPacket);
+	prChipInfo = prAdapter->chip_info;
+
