+#if CFG_SUPPORT_CHNL_CONFLICT_REVISE
+BOOLEAN cnmAisDetectP2PChannel(P_ADAPTER_T prAdapter, P_ENUM_BAND_T prBand, PUINT_8 pucPrimaryChannel)
+{
+	UINT_8 i = 0;
