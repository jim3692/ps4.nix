+          # work. It's redundant to specify them in every command (seemingly)
+
+          # march and mtune optimize the the build instructions
+          # march = oldest architecture on which this code can run
+          # mtune = compiler hint for which architecture the instructions should be
+          # optimized for. The PS4 CPU architecture was based on btver2,
+          # also known as the AMD Jaguar architecture
+
+          # We don't know if -O3 will help, but really anything will help
+          # considering our target hardware was aging when it was new
+
+          export MAKE_OPTS="-j`nproc --ignore=1` \
+                     INSTALL_PATH=${GCE_INSTALL_DIR}/boot \
+                     INSTALL_MOD_PATH=${GCE_INSTALL_DIR} \
+                     LLVM=1"
+                     # Macro for all the LLVM specific switches. 1 = whatever LLVM present
+                     # Otherwise you may specify the major version (e.g. LLVM=-14) of the LLVM installation
+                     # We ignore 1 core because full LTO runs OOM, even with 10 G swap (would be 3/4 cores)
+
+          mkdir -p ${GCE_BUILD_DIR}
+          mkdir -p ${GCE_INSTALL_DIR}/boot
+          mkdir -p ${GCE_PKG_DIR}
+          echo "Debugging gce directory."
+          find ${GCE_BUILD_DIR} ${GCE_INSTALL_DIR}/boot ${GCE_PKG_DIR}
+
+          echo -e "\n\n\n Current system resources inside of Docker : : :"
+          echo "CPU cores: `nproc`"
+          echo "RAM: `free -h`"
+          echo "Disk: `df -h`"
+          echo "CPU info: `lscpu | grep 'Model name'`"
+          #echo "System max memory: `cat /sys/fs/cgroup/memory.max`" ;; No such file or dir
+
+          # Enable Full LTO from the config (should be redundant as FullLTO is already set)
+          scripts/config --enable CONFIG_LTO_CLANG_FULL
+
+          make ${MAKE_OPTS} olddefconfig
+          make ${MAKE_OPTS} prepare
+          echo "Making kernel. . ."
+          make ${MAKE_OPTS}
+          echo "Making modules . . ."
+          make ${MAKE_OPTS} modules
+          echo "Installing kernel . . ."
+          make ${MAKE_OPTS} install
+          echo "Installing modules . . ."
+          make ${MAKE_OPTS} modules_install
