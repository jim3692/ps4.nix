diff --git a/build.sh b/build.sh
index a4429622a5e6121cb00396f49b8a6ff795a7d936..3269dea7a5e5a2c695ee6d014250e90430483c98 100755
--- a/build.sh
+++ b/build.sh
@@ -17,6 +17,19 @@ REQUIRED_PS4_AMDGPU_FW=(
     "amdgpu/liverpool_sdma1.bin"
     "amdgpu/liverpool_refresh_uvd.bin"
     "amdgpu/liverpool_vce.bin"
+    "amdgpu/gladius_a_ce.bin"
+    "amdgpu/gladius_a_me.bin"
+    "amdgpu/gladius_a_mec.bin"
+    "amdgpu/gladius_a_mec2.bin"
+    "amdgpu/gladius_a_pfp.bin"
+    "amdgpu/gladius_b_ce.bin"
+    "amdgpu/gladius_b_me.bin"
+    "amdgpu/gladius_b_mec.bin"
+    "amdgpu/gladius_b_mec2.bin"
+    "amdgpu/gladius_b_pfp.bin"
+    "amdgpu/gladius_rlc.bin"
+    "amdgpu/gladius_sdma.bin"
+    "amdgpu/gladius_sdma1.bin"
 )
