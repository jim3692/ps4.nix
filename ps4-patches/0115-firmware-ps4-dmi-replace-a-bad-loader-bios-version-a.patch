From 576471518b8c0d06bc08e1808c7a788570dfb254 Mon Sep 17 00:00:00 2001
From: Armandas Kvietkus <armandas.kvietkus@proton.me>
Date: Tue, 10 Nov 2026 21:09:53 +0100
Subject: [PATCH 115/124] firmware: ps4-dmi: replace a bad loader bios version
 and date

Signed-off-by: Armandas Kvietkus <armandas.kvietkus@proton.me>
---
 drivers/firmware/ps4-dmi.c | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/drivers/firmware/ps4-dmi.c b/drivers/firmware/ps4-dmi.c
index b58e0fba3220b477403bccdd29bd53e2aad3c46c..9cb7c4d4a963a91620ec288d93727584243b3ae5 100644
--- a/drivers/firmware/ps4-dmi.c
+++ b/drivers/firmware/ps4-dmi.c
@@ -1,8 +1,10 @@
 // SPDX-License-Identifier: GPL-2.0-only
 
+#include <linux/ctype.h>
 #include <linux/dmi.h>
 #include <linux/init.h>
 #include <linux/printk.h>
+#include <linux/string.h>
 
 #include "ps4-dmi.h"
 
@@ -22,10 +24,33 @@ static const char * const ps4_strings[DMI_STRING_MAX] = {
 	[DMI_CHASSIS_TYPE]          = "3",
 };
 
+static bool __init ps4_dmi_date_ok(const char *date)
+{
+	int i;
+
+	if (strlen(date) != 10)
+		return false;
+	for (i = 0; i < 10; i++) {
+		if (i == 2 || i == 5) {
+			if (date[i] != '/')
+				return false;
+		} else if (!isdigit(date[i])) {
+			return false;
+		}
+	}
+	return true;
+}
+
 void __init ps4_dmi_populate(const char *ident[DMI_STRING_MAX])
 {
 	int i;
 
+	if (ident[DMI_BIOS_DATE] && !ps4_dmi_date_ok(ident[DMI_BIOS_DATE])) {
+		pr_info("ps4_dmi: replacing the bad loader bios version and date\n");
+		ident[DMI_BIOS_VERSION] = ps4_strings[DMI_BIOS_VERSION];
+		ident[DMI_BIOS_DATE] = ps4_strings[DMI_BIOS_DATE];
+	}
+
 	pr_info("ps4_dmi: filling missing DMI fields with PS4 defaults\n");
 
 	for (i = 0; i < DMI_STRING_MAX; i++) {
