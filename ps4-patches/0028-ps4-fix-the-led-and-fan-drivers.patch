-		      (void *)payload, PS4_LED_PAYLOAD_LEN,
-		      led_reply, sizeof(led_reply));
-
-reschedule:
-	schedule_delayed_work(&priv->thermal_work,
-			      msecs_to_jiffies(interval_ms));
-}
