-#define kalStrnCpy(dest, src, n)                    strncpy(dest, src, n)
+static inline char *kalStrncpyCompat(char *dest, const char *src, size_t n)
+{
+	size_t i;
+
+	for (i = 0; i < n && src[i]; i++)
+		dest[i] = src[i];
+	for (; i < n; i++)
+		dest[i] = '\0';
+	return dest;
+}
+
+#define kalStrnCpy(dest, src, n)                    kalStrncpyCompat(dest, src, n)
