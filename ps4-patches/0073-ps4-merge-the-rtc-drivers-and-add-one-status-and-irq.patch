@@ -44,12 +44,14 @@ extern int ps4_samu_map(struct page **pages, unsigned int count, u64 *va);
 extern void ps4_samu_unmap(void);
 extern int ps4_samu_rng(void *buf, size_t len);
 extern int ps4_samu_ccp(void *op);
-extern int apcie_status(void);
+extern bool ps4sb_initialized;
+extern int ps4sb_status(void);
+extern int ps4sb_assign_irqs(struct pci_dev *dev, int nvec);
+extern void ps4sb_free_irqs(unsigned int virq, unsigned int nr_irqs);
 extern bool ps4_is_baikal(void);
 extern int bpcie_assign_irqs(struct pci_dev *dev, int nvec);
 extern void bpcie_free_irqs(unsigned int virq, unsigned int nr_irqs);
 extern void ps4sb_icc_reboot(void);
-extern int bpcie_status(void);
 extern int ps4sb_icc_cmd(u8 major, u16 minor, const void *data,
 			 u16 length, void *reply, u16 reply_length);
 extern int ps4sb_icc_register_event_handler(u8 major, ps4sb_icc_event_fn fn,
@@ -61,14 +63,14 @@ extern void ps4sb_icc_unregister_event_handler(u8 major);
 
 typedef void (*ps4sb_icc_event_fn)(void *ctx, u16 minor, const u8 *data,
 				   u16 length);
-static inline int apcie_assign_irqs(struct pci_dev *dev, int nvec)
+static inline int ps4sb_assign_irqs(struct pci_dev *dev, int nvec)
 {
 	return -ENODEV;
 }
-static inline void apcie_free_irqs(unsigned int virq, unsigned int nvec)
+static inline void ps4sb_free_irqs(unsigned int virq, unsigned int nr_irqs)
 {
 }
-static inline int apcie_status(void)
+static inline int ps4sb_status(void)
 {
 	return -ENODEV;
 }
@@ -76,17 +78,6 @@ static inline bool ps4_is_baikal(void)
 {
 	return false;
 }
-static inline int bpcie_assign_irqs(struct pci_dev *dev, int nvec)
-{
-	return -ENODEV;
-}
-static inline void bpcie_free_irqs(unsigned int virq, unsigned int nvec)
-{
-}
-static inline int bpcie_status(void)
-{
-	return -ENODEV;
-}
 static inline int ps4sb_icc_cmd(u8 major, u16 minor, const void *data,
 				u16 length, void *reply, u16 reply_length)
 {
diff --git a/arch/x86/platform/ps4/ps4.c b/arch/x86/platform/ps4/ps4.c
index 947173e4bfe2bc3250d46094ace851e69cbbf4b5..564eb3112751750041587f2184e884f351dd09d2 100644
--- a/arch/x86/platform/ps4/ps4.c
+++ b/arch/x86/platform/ps4/ps4.c
@@ -31,8 +31,7 @@
 
 static bool is_ps4;
 static bool is_baikal;
-bool apcie_initialized;
-bool bpcie_initialized;
+bool ps4sb_initialized;
 
 /*
  * The RTC is part of the Aeolia PCI device and will be implemented there as
@@ -47,25 +46,29 @@ static int dummy_set_wallclock(const struct timespec64 *now)
 	return -ENODEV;
 }
 
-/*
- * Provide a way for generic drivers to query for the availability of the
- * PS4 apcie driver/device, which is a dependency for them.
- */
-int apcie_status(void)
+int ps4sb_status(void)
 {
 	if (!is_ps4)
 		return -ENODEV;
-	return READ_ONCE(apcie_initialized) || READ_ONCE(bpcie_initialized);
+	return READ_ONCE(ps4sb_initialized);
 }
-EXPORT_SYMBOL_GPL(apcie_status);
+EXPORT_SYMBOL_GPL(ps4sb_status);
 
-int bpcie_status(void)
+int ps4sb_assign_irqs(struct pci_dev *dev, int nvec)
 {
-	if (!is_ps4)
-		return -ENODEV;
-	return READ_ONCE(bpcie_initialized);
+	return is_baikal ? bpcie_assign_irqs(dev, nvec) :
+			   apcie_assign_irqs(dev, nvec);
+}
+EXPORT_SYMBOL_GPL(ps4sb_assign_irqs);
+
+void ps4sb_free_irqs(unsigned int virq, unsigned int nr_irqs)
+{
+	if (is_baikal)
+		bpcie_free_irqs(virq, nr_irqs);
+	else
+		apcie_free_irqs(virq, nr_irqs);
 }
-EXPORT_SYMBOL_GPL(bpcie_status);
+EXPORT_SYMBOL_GPL(ps4sb_free_irqs);
 
 bool ps4_is_baikal(void)
 {
