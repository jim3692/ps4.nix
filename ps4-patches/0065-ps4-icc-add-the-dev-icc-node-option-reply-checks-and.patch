From f48c898c213bb3f5e7b3226c319b4b0f99e0842a Mon Sep 17 00:00:00 2001
From: Armandas Kvietkus <armandas.kvietkus@proton.me>
Date: Fri, 6 Nov 2026 18:28:56 +0100
Subject: [PATCH 065/124] ps4: icc: add the /dev/icc node option, reply checks
 and per chip i2c offsets

Signed-off-by: Armandas Kvietkus <armandas.kvietkus@proton.me>
---
 arch/x86/Kconfig            |  7 +++
 config                      |  1 +
 drivers/ps4/icc/i2c.c       | 26 ++++++++---
 drivers/ps4/ps4-apcie-icc.c | 86 +++++++++++++++++++++++++++++++++----
 drivers/ps4/ps4-bpcie-icc.c | 32 ++++++++++++++
 5 files changed, 136 insertions(+), 16 deletions(-)

diff --git a/arch/x86/Kconfig b/arch/x86/Kconfig
index c6cd7cc8905cd0f719f9c441351b7173fc8f785c..f55fe3016e830a4e8226d9f165dabaa9f659211b 100644
--- a/arch/x86/Kconfig
+++ b/arch/x86/Kconfig
@@ -612,6 +612,13 @@ config X86_PS4
 	help
 	  Select to include support for the Sony PlayStation 4 game console.
 
+config PS4_ICCNODE
+	bool "PS4 /dev/icc character device node"
+	depends on X86_PS4
+	default y
+	help
+	  Enable userspace /dev/icc character device node and ioctl interface.
+
 config X86_PS4_BAIKAL
 	bool "Sony PlayStation 4 Baikal southbridge support"
 	depends on X86_PS4
diff --git a/config b/config
index 0b41b1537dd0c8be81fa9d99237a94ed9d79fb05..b72c7415f28eb43e20fda32f43d134fd8ed41f84 100644
--- a/config
+++ b/config
@@ -362,6 +362,7 @@ CONFIG_X86_MPPARSE=y
 # CONFIG_X86_FRED is not set
 CONFIG_X86_EXTENDED_PLATFORM=y
 CONFIG_X86_PS4=y
+CONFIG_PS4_ICCNODE=y
 CONFIG_X86_PS4_BAIKAL=y
 CONFIG_PS4_CCP=y
 CONFIG_PS4_TRNG=y
diff --git a/drivers/ps4/icc/i2c.c b/drivers/ps4/icc/i2c.c
index ac8dca8ab1fdf1f0caff3934aebb03145df76a27..7996898f539f8948480c48bb6dab2555f4adb9bd 100644
--- a/drivers/ps4/icc/i2c.c
+++ b/drivers/ps4/icc/i2c.c
@@ -2,10 +2,14 @@
 #include <linux/serial_core.h>
 #include <linux/serial_reg.h>
 
+#include <asm/ps4.h>
+
 #include "../aeolia.h"
 
 #define ICC_MAX_READ_DATA 0xff
 #define ICC_MAX_WRITE_DATA 0xf8
+#define ICC_REPLY_HEADER_SIZE 0x14
+#define ICC_REPLY_ERROR_OFF 0x0c
 
 u32 icc_i2c_functionality(struct i2c_adapter *adap);
 int icc_i2c_init(struct apcie_dev *sc);
@@ -41,7 +45,9 @@ static int icc_i2c_smbus_xfer(struct i2c_adapter *adapter, u16 addr,
 	struct apcie_dev *sc = i2c_get_adapdata(adapter);
 	int ret;
 	struct icc_i2c_msg msg;
-	u8 resultbuf[8 + ICC_MAX_READ_DATA];
+	u8 resultbuf[ICC_REPLY_HEADER_SIZE + ICC_MAX_READ_DATA];
+	int data_off = ICC_REPLY_HEADER_SIZE;
+	int err_off = ICC_REPLY_ERROR_OFF;
 
 	msg.code = 4; /* Don't really know what this is */
 	msg.count = 1;
@@ -93,28 +99,34 @@ static int icc_i2c_smbus_xfer(struct i2c_adapter *adapter, u16 addr,
 	}
 
 	msg.length = msg.cmd.length + 4;
+#ifdef CONFIG_X86_PS4_BAIKAL
+	if (bpcie_status() > 0) {
+		data_off = 8;
+		err_off = 0;
+	}
+#endif
 	ret = apcie_icc_cmd(0x10, 0x0, &msg, msg.length, resultbuf,
 		      sizeof(resultbuf));
-	if (ret < 2 || ret > sizeof(resultbuf)) {
+	if (ret < err_off + 2 || ret > sizeof(resultbuf)) {
 		sc_err("icc-i2c: icc command failed: %d\n", ret);
 		return -EIO;
 	}
-	if (resultbuf[0] != 0 || resultbuf[1] != 0) {
+	if (resultbuf[err_off] != 0 || resultbuf[err_off + 1] != 0) {
 		sc_err("icc-i2c: i2c command failed: %d, %d\n",
-		       resultbuf[0], resultbuf[1]);
+		       resultbuf[err_off], resultbuf[err_off + 1]);
 		return -EIO;
 	}
 
 	if (read_write == I2C_SMBUS_READ)
 		switch (size) {
 		case I2C_SMBUS_BYTE_DATA:
-			data->byte = resultbuf[8];
+			data->byte = resultbuf[data_off];
 			break;
 		case I2C_SMBUS_WORD_DATA:
-			data->word = resultbuf[8] | (resultbuf[9] << 8);
+			data->word = resultbuf[data_off] | (resultbuf[data_off + 1] << 8);
 			break;
 		case I2C_SMBUS_I2C_BLOCK_DATA:
-			memcpy(&data->block[1], &resultbuf[8],
+			memcpy(&data->block[1], &resultbuf[data_off],
 			       data->block[0]);
 			break;
 		}
diff --git a/drivers/ps4/ps4-apcie-icc.c b/drivers/ps4/ps4-apcie-icc.c
index 94074d17452a4e74b4fa7872b2c7e0bb4857f546..db6a33b6d64e3fe138d5790978231b685f4ae38c 100644
--- a/drivers/ps4/ps4-apcie-icc.c
+++ b/drivers/ps4/ps4-apcie-icc.c
@@ -6,6 +6,7 @@
 #include <linux/delay.h>
 #include <linux/fs.h>
 #include <linux/uaccess.h>
+#include <linux/device.h>
 #include <asm/ps4.h>
 #include "aeolia.h"
 
@@ -14,9 +15,13 @@
  * having to get a reference to the device. */
 static struct apcie_dev *icc_sc;
 DEFINE_MUTEX(icc_mutex);
+#ifdef CONFIG_PS4_ICCNODE
 static DEFINE_MUTEX(icc_ioctl_mutex);
 static bool icc_chrdev_registered;
 static int icc_major;
+static struct class *icc_class;
+static struct device *icc_device;
+#endif
 
 /* The ICC message passing interface seems to be potentially designed to
  * support multiple outstanding requests at once, but the original PS4 OS never
@@ -318,6 +323,11 @@ __maybe_unused void resetUsbPort(void)
 		pr_err("icc: USB disable failed: %d\n", ret);
 		return;
 	}
+	if (resp[0] != 0 || resp[1] != 0) {
+		pr_err("icc: USB disable reported failure: %d, %d\n",
+			resp[0], resp[1]);
+		return;
+	}
 	pr_debug("icc: USB disable ret=%d, reply %02x %02x %02x %02x\n",
 		 ret, resp[0], resp[1], resp[2], resp[3]);
 
@@ -327,6 +337,11 @@ __maybe_unused void resetUsbPort(void)
 		pr_err("icc: USB enable failed: %d\n", ret);
 		return;
 	}
+	if (resp[0] != 0 || resp[1] != 0) {
+		pr_err("icc: USB enable reported failure: %d, %d\n",
+			resp[0], resp[1]);
+		return;
+	}
 	pr_debug("icc: USB enable ret=%d, reply %02x %02x %02x %02x\n",
 		 ret, resp[0], resp[1], resp[2], resp[3]);
 }
@@ -352,6 +367,11 @@ void resetBtWlan(void)
 		pr_err("icc: BT/WLAN enable failed: %d\n", ret);
 		return;
 	}
+	if (resp[0] != 0 || resp[1] != 0) {
+		pr_err("icc: BT/WLAN enable reported failure: %d, %d\n",
+			resp[0], resp[1]);
+		return;
+	}
 	pr_debug("icc: BT/WLAN enable ret=%d, reply %02x %02x %02x %02x\n",
 		 ret, resp[0], resp[1], resp[2], resp[3]);
 }
@@ -360,15 +380,11 @@ void do_icc_init(void) {
 	u8 svc = 0x10;
 	u8 reply[0x30];
 	static const u8 led_config[] = {
-		3, 1, 0, 0,
-			0x10, 1, /* Blue: on */
-				2, 0xff, 2, 1, 0x00,
-			0x11, 1, /* White: off */
+		2, 1, 0, 0,
+			0x10, 1,
 				2, 0x00, 2, 1, 0x00,
-			0x02, 3, /* Orange: delay and pulse, loop forever */
-				1, 0x00, 4, 1, 0xbf,
-				2, 0xff, 5, 1, 0xff,
-				2, 0x00, 5, 1, 0xff,
+			0x11, 1,
+				2, 0xff, 2, 1, 0x00,
 	};
 	int ret;
 	// test: get FW version
@@ -397,6 +413,29 @@ void do_icc_init(void) {
 			 reply[4], reply[5], reply[6], reply[7]);
 }
 
+static int __init ps4_led_boot_complete(void)
+{
+	static const u8 led_config[] = {
+		2, 1, 0, 0,
+			0x10, 1,
+				2, 0xff, 2, 1, 0x00,
+			0x11, 1,
+				2, 0x00, 2, 1, 0x00,
+	};
+	u8 reply[0x30];
+	int ret;
+
+	if (!icc_sc)
+		return 0;
+
+	ret = apcie_icc_cmd(9, 0x20, led_config, ARRAY_SIZE(led_config), reply, 0x30);
+	if (ret < 0)
+		pr_err("icc: boot-complete LED set failed: %d\n", ret);
+
+	return 0;
+}
+late_initcall(ps4_led_boot_complete);
+
 static void icc_shutdown(void)
 {
 	uint8_t command[] = {
@@ -421,6 +460,7 @@ void icc_reboot(void)
 	WARN_ON(1);
 }
 
+#ifdef CONFIG_PS4_ICCNODE
 static void *ioctl_send_buf;
 static void *ioctl_reply_buf;
 
@@ -504,6 +544,7 @@ out_unlock_ioctl:
  	.owner = THIS_MODULE,
  	.unlocked_ioctl = icc_ioctl,
  };
+#endif
 
 int apcie_icc_init(struct apcie_dev *sc)
 {
@@ -594,6 +635,7 @@ int apcie_icc_init(struct apcie_dev *sc)
 	do_icc_init();
 	pm_power_off = &icc_shutdown;
 
+#ifdef CONFIG_PS4_ICCNODE
 	ioctl_send_buf = kzalloc(ICC_MAX_PAYLOAD, GFP_KERNEL);
 	if (!ioctl_send_buf) {
 		sc_warn("icc: alloc ioctl_send_buf failed, leaving /dev/icc disabled\n");
@@ -615,11 +657,27 @@ int apcie_icc_init(struct apcie_dev *sc)
 		kfree(ioctl_send_buf);
 		ioctl_reply_buf = NULL;
 		ioctl_send_buf = NULL;
-		goto unassign_global;
+		goto done;
 	}
 	icc_major = ret;
 	icc_chrdev_registered = true;
+
+	icc_class = class_create("icc");
+	if (IS_ERR(icc_class)) {
+		sc_warn("icc: class_create failed (%ld), /dev/icc unavailable\n",
+			PTR_ERR(icc_class));
+		icc_class = NULL;
+	} else {
+		icc_device = device_create(icc_class, NULL,
+					   MKDEV(icc_major, 0), NULL, "icc");
+		if (IS_ERR(icc_device)) {
+			sc_warn("icc: device_create failed (%ld), /dev/icc unavailable\n",
+				PTR_ERR(icc_device));
+			icc_device = NULL;
+		}
+	}
  done:
+#endif
 
 	return 0;
 
@@ -646,7 +704,16 @@ put_mem_dev:
 void apcie_icc_remove(struct apcie_dev *sc)
 {
 	sc_err("apcie_icc_remove: shouldn't normally be called\n");
+#ifdef CONFIG_PS4_ICCNODE
 	if (icc_chrdev_registered) {
+		if (icc_device) {
+			device_destroy(icc_class, MKDEV(icc_major, 0));
+			icc_device = NULL;
+		}
+		if (icc_class) {
+			class_destroy(icc_class);
+			icc_class = NULL;
+		}
 		unregister_chrdev(icc_major, "icc");
 		icc_major = 0;
 		icc_chrdev_registered = false;
@@ -655,6 +722,7 @@ void apcie_icc_remove(struct apcie_dev *sc)
 	kfree(ioctl_send_buf);
 	ioctl_reply_buf = NULL;
 	ioctl_send_buf = NULL;
+#endif
 	pm_power_off = NULL;
 	icc_pwrbutton_remove(sc);
 	icc_i2c_remove(sc);
diff --git a/drivers/ps4/ps4-bpcie-icc.c b/drivers/ps4/ps4-bpcie-icc.c
index 08c9a7da34acb5a76a3f6eb3aaae1a327d907199..97ace912f244467a5a0c07c64cb238ce8cba4e3b 100644
--- a/drivers/ps4/ps4-bpcie-icc.c
+++ b/drivers/ps4/ps4-bpcie-icc.c
@@ -6,6 +6,7 @@
 #include <linux/delay.h>
 #include <linux/fs.h>
 #include <linux/uaccess.h>
+#include <linux/device.h>
 #include <linux/reboot.h>
 #include <linux/spinlock.h>
 #include <linux/workqueue.h>
@@ -539,6 +540,10 @@ static int icc_sys_off_cb(struct sys_off_data *data)
 
 static void *ioctl_tmp_buf = NULL;
 static bool icc_chrdev_registered;
+#ifdef CONFIG_PS4_ICCNODE
+static struct class *icc_class;
+static struct device *icc_device;
+#endif
 
  static long icc_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
  {
@@ -674,6 +679,23 @@ int bpcie_icc_init(struct bpcie_dev *sc)
  		goto done;
  	}
 	icc_chrdev_registered = true;
+
+#ifdef CONFIG_PS4_ICCNODE
+	icc_class = class_create("icc");
+	if (IS_ERR(icc_class)) {
+		sc_warn("icc: class_create failed (%ld), /dev/icc unavailable\n",
+			PTR_ERR(icc_class));
+		icc_class = NULL;
+	} else {
+		icc_device = device_create(icc_class, NULL,
+					   MKDEV(ICC_MAJOR, 0), NULL, "icc");
+		if (IS_ERR(icc_device)) {
+			sc_warn("icc: device_create failed (%ld), /dev/icc unavailable\n",
+				PTR_ERR(icc_device));
+			icc_device = NULL;
+		}
+	}
+#endif
  done:
 	pci_dev_put(mem_dev);
 
@@ -699,6 +721,16 @@ void bpcie_icc_remove(struct bpcie_dev *sc)
 {
 	sc_err("bpcie_icc_remove: shouldn't normally be called\n");
 	if (icc_chrdev_registered) {
+#ifdef CONFIG_PS4_ICCNODE
+		if (icc_device) {
+			device_destroy(icc_class, MKDEV(ICC_MAJOR, 0));
+			icc_device = NULL;
+		}
+		if (icc_class) {
+			class_destroy(icc_class);
+			icc_class = NULL;
+		}
+#endif
 		unregister_chrdev(ICC_MAJOR, "icc");
 		icc_chrdev_registered = false;
 	}
