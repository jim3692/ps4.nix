+static void gladius_apply_golden(struct amdgpu_device *adev)
+{
+	if (RREG32(0x203e) & 2)
+		amdgpu_device_program_register_sequence(adev, gladius_golden_var1,
+							ARRAY_SIZE(gladius_golden_var1));
+	else
+		amdgpu_device_program_register_sequence(adev, gladius_golden_var0,
+							ARRAY_SIZE(gladius_golden_var0));
+}
+
 static void gfx_v7_0_config_init(struct amdgpu_device *adev)
 {
 	adev->gfx.config.double_offchip_lds_buf = 1;
 }
 
-/*
- * GB_ADDR_CONFIG only retains ROW_SIZE on this chip. Pipe, SE, and
- * NUM_LOWER_PIPES bits are discarded on readback. Do not keep a leftover
- * 2KB row: Orbis HDP tiling is ROW_SIZE=1KB (0x42011003).
- */
-static void gladius_commit_gb_row_size(struct amdgpu_device *adev)
+static void gladius_constants_init(struct amdgpu_device *adev)
 {
 	u32 sw = adev->gfx.config.gb_addr_config;
-	u32 hdp, gb, sw_row, gb_row, hdp_row;
 
 	mutex_lock(&adev->grbm_idx_mutex);
 	gfx_v7_0_select_se_sh(adev, 0xffffffff, 0xffffffff, 0xffffffff, 0);
-
-	WREG32(mmGB_ADDR_CONFIG, sw);
-	WREG32(mmHDP_ADDR_CONFIG, sw);
+	gladius_apply_golden(adev);
+	WREG32(mmHDP_ADDR_CONFIG, sw & ~GB_ADDR_CONFIG__ROW_SIZE_MASK);
 	WREG32(mmDMIF_ADDR_CALC, sw);
+	WREG32(mmPA_SC_FORCE_EOV_MAX_CNTS, 0x00ffffff);
+	mutex_unlock(&adev->grbm_idx_mutex);
 
-	gb = RREG32(mmGB_ADDR_CONFIG);
-	hdp = RREG32(mmHDP_ADDR_CONFIG);
-	sw_row = (sw & GB_ADDR_CONFIG__ROW_SIZE_MASK) >>
-		 GB_ADDR_CONFIG__ROW_SIZE__SHIFT;
-	gb_row = (gb & GB_ADDR_CONFIG__ROW_SIZE_MASK) >>
-		 GB_ADDR_CONFIG__ROW_SIZE__SHIFT;
-	hdp_row = (hdp & GB_ADDR_CONFIG__ROW_SIZE_MASK) >>
-		  GB_ADDR_CONFIG__ROW_SIZE__SHIFT;
+	adev->gds.gds_compute_max_wave_id = RREG32(mmGDS_COMPUTE_MAX_WAVE_ID);
 
 	dev_info(adev->dev,
-		 "Gladius GB ROW_SIZE-only: wrote 0x%08x readback 0x%08x (row %u) HDP 0x%08x (row %u) sw 0x%08x (row %u)\n",
-		 sw, gb, gb_row, hdp, hdp_row, sw, sw_row);
-	mutex_unlock(&adev->grbm_idx_mutex);
+		 "Gladius GB_ADDR_CONFIG 0x%08x HDP 0x%08x DMIF 0x%08x DB_DEBUG2 0x%08x CB_HW_CONTROL 0x%08x TCP_ADDR_CONFIG 0x%08x GDS_MAX_WAVE 0x%08x sw 0x%08x\n",
+		 RREG32(mmGB_ADDR_CONFIG), RREG32(mmHDP_ADDR_CONFIG),
+		 RREG32(mmDMIF_ADDR_CALC), RREG32(mmDB_DEBUG2),
+		 RREG32(mmCB_HW_CONTROL), RREG32(mmTCP_ADDR_CONFIG),
+		 adev->gds.gds_compute_max_wave_id, sw);
 }
 
 static const struct {
@@ -2973,7 +3228,7 @@ static void gfx_v7_0_constants_init(struct amdgpu_device *adev)
 	mutex_unlock(&adev->grbm_idx_mutex);
 
 	if (adev->asic_type == CHIP_GLADIUS)
-		gladius_commit_gb_row_size(adev);
+		gladius_constants_init(adev);
 
 	if (adev->asic_type == CHIP_LIVERPOOL)
 		gfx_v7_0_liverpool_constants_init(adev);
@@ -5270,6 +5525,8 @@ static void gfx_v7_0_gpu_early_init(struct amdgpu_device *adev)
 				gb_addr_config = gb;
 			else
 				gb_addr_config = GLADIUS_GB_ADDR_CONFIG_DUMP;
+			gb_addr_config &= ~GB_ADDR_CONFIG__ROW_SIZE_MASK;
+			gb_addr_config |= 1 << GB_ADDR_CONFIG__ROW_SIZE__SHIFT;
 		}
 		break;
 	case CHIP_KABINI:
@@ -5548,6 +5805,7 @@ static void gfx_v7_0_init_golden_registers(struct amdgpu_device *adev)
 		amdgpu_device_program_register_sequence(adev,
 							gladius_golden_common_registers,
 							ARRAY_SIZE(gladius_golden_common_registers));
+		gladius_apply_golden(adev);
 		break;
 	default:
 		break;
