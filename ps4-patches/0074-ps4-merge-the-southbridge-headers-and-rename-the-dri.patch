-static int apcie_probe(struct pci_dev *dev, const struct pci_device_id *id) {
-	struct apcie_dev *sc;
-	int ret;
-
-	dev_dbg(&dev->dev, "apcie_probe()\n");
-
-	ret = pci_enable_device(dev);
-	if (ret) {
-		dev_err(&dev->dev,
-			"apcie_probe(): pci_enable_device failed: %d\n", ret);
-		return ret;
-	}
-
-	sc = kzalloc(sizeof(*sc), GFP_KERNEL);
-	if (!sc) {
-		dev_err(&dev->dev, "apcie_probe(): alloc sc failed\n");
-		ret = -ENOMEM;
-		goto disable_dev;
-	}
-	sc->pdev = dev;
-	sc->family = &aeolia_family;
-	memset(sc->irq_map, -1, sizeof(sc->irq_map));
-	memset(sc->serial_line, -1, sizeof(sc->serial_line));
-	pci_set_drvdata(dev, sc);
-
-	// eMMC ... unused?
-	sc->bar0 = pci_ioremap_bar(dev, 0);
-	// pervasive 0
-	sc->bar2 = pci_ioremap_bar(dev, 2);
-	// pervasive 1 - misc peripherals
-	sc->bar4 = pci_ioremap_bar(dev, 4);
-
-	if (!sc->bar0 || !sc->bar2 || !sc->bar4) {
-		sc_err("failed to map some BARs, bailing out\n");
-		ret = -EIO;
-		goto free_bars;
-	}
-
-	if ((ret = apcie_glue_init(sc)) < 0)
-		goto free_bars;
-	if (ps4sb_rtc_init(sc) < 0)
-		sc_err("rtc not registered\n");
-	if ((ret = ps4sb_icc_init(sc)) < 0)
-		goto remove_glue;
-
-	WRITE_ONCE(ps4sb_initialized, true);
-	return 0;
-
-remove_glue:
-	apcie_glue_remove(sc);
-free_bars:
-	if (sc->bar0)
-		iounmap(sc->bar0);
-	if (sc->bar2)
-		iounmap(sc->bar2);
-	if (sc->bar4)
-		iounmap(sc->bar4);
-	kfree(sc);
-disable_dev:
-	pci_disable_device(dev);
-	return ret;
-}
-
-static void apcie_remove(struct pci_dev *dev) {
-	struct apcie_dev *sc;
-	sc = pci_get_drvdata(dev);
-
-	WRITE_ONCE(ps4sb_initialized, false);
-	ps4sb_icc_remove(sc);
-	ps4sb_uart_remove(sc);
-	apcie_glue_remove(sc);
-
-	if (sc->bar0)
-		iounmap(sc->bar0);
-	if (sc->bar2)
-		iounmap(sc->bar2);
-	if (sc->bar4)
-		iounmap(sc->bar4);
-	kfree(sc);
-	pci_disable_device(dev);
-}
