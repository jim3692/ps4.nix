+};
+
+static const struct baikal_sata_rmw baikal_sata_trace_13_18[] = {
+	{ 0x204C, 0xFFC0FFFF, 0x260000 },
+	{ 0x204C, 0xC0FFFFFF, 0x7000000 },
+	{ 0x2054, 0xFFFF9FFF, 0x2000 },
+	{ 0x207C, 0xFFFFF03F, 0x880 },
+	{ 0x207C, 0xFFFC0FFF, 0x6000 },
+	{ 0x205C, 0xCFFFFFFF, 0x10000000 },
+	{ 0x2080, 0xFFFFF03F, 0x900 },
+	{ 0x2080, 0xFFFC0FFF, 0xF000 },
+	{ 0x205C, 0x3FFFFFFF, 0x40000000 },
+	{ 0x204C, 0xFFFFFFF0, 0x5 },
+	{ 0x206C, 0xFFFFF0FF, 0x200 },
+	{ 0x2084, 0xFFFFFF00, 0x55 },
+};
+
+static const struct {
+	u32 max_length;
+	const struct baikal_sata_rmw *rmw;
+	size_t count;
+} baikal_sata_trace_sets[] = {
+	{ 2, baikal_sata_trace_0_2, ARRAY_SIZE(baikal_sata_trace_0_2) },
+	{ 5, baikal_sata_trace_3_5, ARRAY_SIZE(baikal_sata_trace_3_5) },
+	{ 8, baikal_sata_trace_6_8, ARRAY_SIZE(baikal_sata_trace_6_8) },
+	{ 12, baikal_sata_trace_9_12, ARRAY_SIZE(baikal_sata_trace_9_12) },
+	{ 18, baikal_sata_trace_13_18, ARRAY_SIZE(baikal_sata_trace_13_18) },
+};
+
+static bool baikal_baikal_boot_info(bool hdd, u8 *trace, u32 *revision)
+{
+	u8 *page = memremap(BAIKAL_BOOT_PAGE_PHYS, PAGE_SIZE, MEMREMAP_WB);
+
+	*trace = 0;
+	*revision = 0;
+	if (!page)
+		return false;
+	*trace = page[hdd ? BAIKAL_BOOT_TRACE_HDD : BAIKAL_BOOT_TRACE_OTHER];
+	*revision = *(u32 *)(page + BAIKAL_BOOT_REVISION);
+	memunmap(page);
+	return true;
+}
+
+static u32 baikal_sata_trace_length(u8 trace)
+{
+	u32 length = trace & 0x1f;
+
+	if (trace > 0x5f)
+		length += (trace >> 5) - 2;
+	if (!trace || length > 18)
+		length = BAIKAL_SATA_TRACE_DEFAULT;
+	return length;
+}
+
+static void baikal_sata_write_trace_set(void __iomem *mmio, u32 length)
+{
+	size_t i, j;
+
+	for (i = 0; i < ARRAY_SIZE(baikal_sata_trace_sets); i++) {
+		if (length > baikal_sata_trace_sets[i].max_length)
+			continue;
+		for (j = 0; j < baikal_sata_trace_sets[i].count; j++)
+			baikal_ahci_rmw(mmio, baikal_sata_trace_sets[i].rmw[j].reg,
+				       baikal_sata_trace_sets[i].rmw[j].keep,
+				       baikal_sata_trace_sets[i].rmw[j].set);
+		return;
+	}
+}
+
+int baikal_sata_phy_init(struct pci_dev *pdev, void __iomem *ahci_mmio)
+{
+	struct pci_dev *glue_dev;
+	struct ps4sb_dev *sc;
+	u32 efuse0, efuse1;
+	u32 tune0 = 40;
+	u32 tune1 = 16;
+	u32 tune2 = 16;
+	u32 pulse_offset;
+	u32 hold_offset;
+	u32 status;
+	u32 revision;
+	u32 length;
+	u8 trace;
+	bool have_boot;
+	bool shared_path;
+	int ret = 0;
+
+	if (!pdev || pdev->vendor != PCI_VENDOR_ID_SONY || !ahci_mmio)
+		return 0;
+
+	if (pdev->device != PCI_DEVICE_ID_SONY_BAIKAL_AHCI &&
+	    pdev->device != PCI_DEVICE_ID_SONY_BAIKAL_XHCI)
+		return 0;
+
+	glue_dev = pci_get_slot(pdev->bus,
+				(pdev->devfn & ~0x7) | BAIKAL_FUNC_ID_PCIE);
+	if (!glue_dev)
+		return -EPROBE_DEFER;
+
+	if (!baikal_is_compatible_device(glue_dev)) {
+		ret = -ENODEV;
+		goto out_put;
+	}
+
+	sc = pci_get_drvdata(glue_dev);
+	if (!sc || !sc->bar2 || !sc->bar4) {
+		ret = -EPROBE_DEFER;
+		goto out_put;
+	}
+
+	dev_info(&pdev->dev, "Baikal SATA PHY init\n");
+
+	shared_path = pdev->device == PCI_DEVICE_ID_SONY_BAIKAL_XHCI;
+	if (shared_path) {
+		pulse_offset = 112;
+		hold_offset = 48;
+	} else {
+		pulse_offset = 108;
+		hold_offset = 44;
+	}
+
+	glue_write32(sc, BAIKAL_USB_BASE + pulse_offset, 1);
+	glue_write32(sc, BAIKAL_USB_BASE + hold_offset, 1);
+	glue_write32(sc, BAIKAL_USB_BASE + pulse_offset, 0);
+
+	efuse0 = ioread32(sc->bar4 + 0xC000 + 72);
+	efuse1 = ioread32(sc->bar4 + 0xC000 + 108);
+
+	if (shared_path) {
+		if (efuse1 & BIT(26)) {
+			tune0 = (efuse0 >> 16) & 0x3f;
+			tune1 = (efuse0 >> 22) & 0x1f;
+			tune2 = efuse0 >> 27;
+		}
+	} else if (efuse1 & BIT(18)) {
+		tune0 = efuse0 & 0x3f;
+		tune1 = (efuse0 >> 6) & 0x1f;
+		tune2 = efuse0 >> 11;
+	}
+
+	dev_info(&pdev->dev, "Baikal SATA EFUSE VALUE: 0x%02x:0x%02x:0x%02x\n",
+		 tune0, tune1, tune2);
+	have_boot = baikal_baikal_boot_info(shared_path, &trace, &revision);
+	length = baikal_sata_trace_length(trace);
+	if (have_boot)
+		dev_info(&pdev->dev,
+			 "Baikal SATA PHY trace byte 0x%02x, length %u, revision 0x%x\n",
+			 trace, length, revision);
+	else
+		dev_warn(&pdev->dev,
+			 "Baikal SATA PHY boot block not mapped, length %u\n",
+			 length);
+
+	baikal_ahci_rmw(ahci_mmio, 0x20A0, 0xFBFF03FF, (tune0 << 10) | 0x4000000);
+	iowrite32(ioread32(ahci_mmio + 0x2014) | 0x100000, ahci_mmio + 0x2014);
+	baikal_ahci_rmw(ahci_mmio, 0x2054, 0xFFFFF07F, tune1 << 7);
+	iowrite32(ioread32(ahci_mmio + 0x201C) | 0x4, ahci_mmio + 0x201C);
+	baikal_ahci_rmw(ahci_mmio, 0x2078, 0xFFFFFE0F, tune2 << 4);
+
+	baikal_sata_write_trace_set(ahci_mmio, length);
+
+	baikal_ahci_rmw(ahci_mmio, 0x2040, 0xFFFFFFE0, 0x12);
+	baikal_ahci_rmw(ahci_mmio, 0x2040, 0xFFFFC0FF, 0x3100);
+	baikal_ahci_rmw(ahci_mmio, 0x2040, 0xFFE0FFFF, 0xE0000);
+	baikal_ahci_rmw(ahci_mmio, 0x2040, 0xFFFFFF1F, 0x80);
+	if (revision == BAIKAL_REVISION_30100) {
+		iowrite32(ioread32(ahci_mmio + 0x2028) & ~BIT(25),
+			  ahci_mmio + 0x2028);
+		baikal_ahci_rmw(ahci_mmio, 0x2044, 0xFFFFFF80, 0x1C);
+	}
+	baikal_ahci_rmw(ahci_mmio, 0x201C, 0xFF0FFFFF, 0x200000);
+	baikal_ahci_rmw(ahci_mmio, 0x20DC, 0xFFFFE0FF, 0x400);
+	iowrite32(ioread32(ahci_mmio + 0x2024) | 0x30, ahci_mmio + 0x2024);
+
+	glue_write32(sc, BAIKAL_USB_BASE + hold_offset, 0);
+	readl_poll_timeout_atomic(ahci_mmio + 0xDC, status, status & 0x1,
+				  10, 1000);
+
+	baikal_ahci_rmw(ahci_mmio, 0x0, 0xE7FFFFFF, 0);
+	iowrite32(0x1, ahci_mmio + 0x0C);
+	baikal_ahci_rmw(ahci_mmio, 0x0B8, 0xFFFDFFFF, 0);
+	baikal_ahci_rmw(ahci_mmio, 0x118, 0xFFE3FFFF, 0x40000);
+
+out_put:
+	pci_dev_put(glue_dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(baikal_sata_phy_init);
diff --git a/drivers/ps4/sb-icc-i2c.c b/drivers/ps4/sb-icc-i2c.c
new file mode 100644
index 0000000000000000000000000000000000000000..1463945cc14f2af1f0818d84e455cbab815308e9
--- /dev/null
+++ b/drivers/ps4/sb-icc-i2c.c
@@ -0,0 +1,166 @@
+#include <linux/serial_8250.h>
+#include <linux/serial_core.h>
+#include <linux/serial_reg.h>
+
+#include <asm/ps4.h>
+
+#include "ps4sb.h"
+
+#define ICC_MAX_READ_DATA 0xff
+#define ICC_MAX_WRITE_DATA 0xf8
+#define ICC_REPLY_HEADER_SIZE 0x14
+
+u32 icc_i2c_functionality(struct i2c_adapter *adap);
+int icc_i2c_init(struct ps4sb_dev *sc);
+void icc_i2c_remove(struct ps4sb_dev *sc);
+
+
+/* This is actually multiple nested variable length structures, but since we
+ * currently only support one op per transaction, we hardcode it. */
+struct icc_i2c_msg {
+	/* Header */
+	u8 code;
+	u16 length;
+	u8 count;
+	struct {
+		u8 major;
+		u8 length;
+		u8 minor;
+		u8 count;
+		struct {
+			u8 length;
+			u8 slave_addr;
+			u8 reg_addr;
+			u8 data[ICC_MAX_WRITE_DATA];
+		} xfer;
+	} cmd;
+} __packed;
+
+static int icc_i2c_smbus_xfer(struct i2c_adapter *adapter, u16 addr,
+			  unsigned short flags,
+			  char read_write, u8 command, int size,
+			  union i2c_smbus_data *data)
+{
+	struct ps4sb_dev *sc = i2c_get_adapdata(adapter);
+	int ret;
+	struct icc_i2c_msg msg;
+	u8 resultbuf[ICC_REPLY_HEADER_SIZE + ICC_MAX_READ_DATA];
+	int data_off = sc->family->i2c_data_off;
+	int err_off = sc->family->i2c_err_off;
+
+	msg.code = 4; /* Don't really know what this is */
+	msg.count = 1;
+	msg.cmd.count = 1;
+	msg.cmd.xfer.slave_addr = addr << 1;
+	msg.cmd.xfer.reg_addr = command;
+	if (read_write == I2C_SMBUS_READ) {
+		msg.cmd.major = 1;
+		msg.cmd.minor = 1;
+		msg.cmd.length = 8;
+		msg.cmd.xfer.data[0] = 0; /* unknown */
+	} else {
+		msg.cmd.major = 2;
+		msg.cmd.minor = 2;
+	}
+
+	switch (size) {
+	case I2C_SMBUS_BYTE_DATA:
+		msg.cmd.xfer.length = 1;
+		if (read_write == I2C_SMBUS_WRITE) {
+			msg.cmd.length = 8;
+			msg.cmd.xfer.data[0] = data->byte;
+		}
+		break;
+	case I2C_SMBUS_WORD_DATA:
+		msg.cmd.xfer.length = 2;
+		if (read_write == I2C_SMBUS_WRITE) {
+			msg.cmd.length = 9;
+			msg.cmd.xfer.data[0] = data->word & 0xff;
+			msg.cmd.xfer.data[1] = data->word >> 8;
+		}
+		break;
+	case I2C_SMBUS_I2C_BLOCK_DATA:
+		msg.cmd.xfer.length = data->block[0];
+		if (read_write == I2C_SMBUS_WRITE) {
+			if (data->block[0] > ICC_MAX_WRITE_DATA) {
+				sc_err("icc-i2c: transaction too large: %d\n",
+				       data->block[0]);
+				return -E2BIG;
+			}
+			msg.cmd.length = 7 + data->block[0];
+			memcpy(msg.cmd.xfer.data, &data->block[1],
+			       data->block[0]);
+		}
+		break;
+	default:
+		sc_err("icc-i2c: unsupported transaction %d\n", size);
+		return -ENOTSUPP;
+	}
+
+	msg.length = msg.cmd.length + 4;
+	ret = ps4sb_icc_cmd(0x10, 0x0, &msg, msg.length, resultbuf,
+		      sizeof(resultbuf));
+	if (ret < err_off + 2 || ret > sizeof(resultbuf)) {
+		sc_err("icc-i2c: icc command failed: %d\n", ret);
+		return -EIO;
+	}
+	if (resultbuf[err_off] != 0 || resultbuf[err_off + 1] != 0) {
+		sc_err("icc-i2c: i2c command failed: %d, %d\n",
+		       resultbuf[err_off], resultbuf[err_off + 1]);
+		return -EIO;
+	}
+
+	if (read_write == I2C_SMBUS_READ)
+		switch (size) {
+		case I2C_SMBUS_BYTE_DATA:
+			data->byte = resultbuf[data_off];
+			break;
+		case I2C_SMBUS_WORD_DATA:
+			data->word = resultbuf[data_off] | (resultbuf[data_off + 1] << 8);
+			break;
+		case I2C_SMBUS_I2C_BLOCK_DATA:
+			memcpy(&data->block[1], &resultbuf[data_off],
+			       data->block[0]);
+			break;
+		}
+
+	return 0;
+}
+
+u32 icc_i2c_functionality(struct i2c_adapter *adap)
+{
+	return I2C_FUNC_SMBUS_BYTE_DATA |
+		I2C_FUNC_SMBUS_WORD_DATA |
+		I2C_FUNC_SMBUS_I2C_BLOCK;
+}
+
+static const struct i2c_algorithm icc_i2c_algo = {
+	.smbus_xfer   = &icc_i2c_smbus_xfer,
+	.functionality = &icc_i2c_functionality,
+};
+
+
+int icc_i2c_init(struct ps4sb_dev *sc)
+{
+	struct i2c_adapter *i2c;
+	int ret;
+
+	i2c = &sc->icc.i2c;
+	i2c->owner = THIS_MODULE;
+	i2c->algo = &icc_i2c_algo;
+	i2c->algo_data = NULL;
+	i2c->dev.parent = &sc->pdev->dev;
+	strncpy(i2c->name, "icc", sizeof(i2c->name));
+	i2c_set_adapdata(i2c, sc);
+	ret = i2c_add_adapter(i2c);
+	if (ret < 0) {
+		sc_err("failed to add i2c adapter\n");
+		return ret;
+	}
+	return 0;
+}
+
+void icc_i2c_remove(struct ps4sb_dev *sc)
+{
+	i2c_del_adapter(&sc->icc.i2c);
+}
diff --git a/drivers/ps4/sb-icc-pwrbutton.c b/drivers/ps4/sb-icc-pwrbutton.c
new file mode 100644
index 0000000000000000000000000000000000000000..d98c71eac4553afc371628b5670127df0c13f1d6
--- /dev/null
+++ b/drivers/ps4/sb-icc-pwrbutton.c
@@ -0,0 +1,76 @@
+#include <linux/input.h>
+#include <asm/ps4.h>
+#include "ps4sb.h"
+
+/* Prototype declarations */
+void icc_pwrbutton_trigger(struct ps4sb_dev *sc, int state);
+int icc_pwrbutton_init(struct ps4sb_dev *sc);
+void icc_pwrbutton_remove(struct ps4sb_dev *sc);
+/* ---------------------- */ //this file just felt very empty at the top hence the comments
+
+void icc_pwrbutton_trigger(struct ps4sb_dev *sc, int state)
+{
+	if (sc->icc.pwrbutton_dev) {
+		input_report_key(sc->icc.pwrbutton_dev, KEY_POWER, state ? 1 : 0);
+		input_sync(sc->icc.pwrbutton_dev);
+	}
+}
+
+int icc_pwrbutton_init(struct ps4sb_dev *sc)
+{
+	int ret = 0;
+	u16 button;
+	struct input_dev *dev;
+
+	dev = input_allocate_device();
+	if (!dev) {
+		sc_err("%s: Not enough memory.\n", __func__);
+		return -ENOMEM;
+	}
+
+	set_bit(EV_KEY, dev->evbit);
+	set_bit(KEY_POWER, dev->keybit);
+
+	dev->name = "Power Button";
+	dev->id.bustype = BUS_HOST;
+
+	/* this makes the button look like an acpi power button
+	 * no clue whether anyone relies on that though */
+	dev->id.product = 0x02;
+	dev->phys = "LNXPWRBN/button/input0";
+
+	dev->dev.parent = &sc->pdev->dev;
+	ret = input_register_device(dev);
+	if (ret) {
+		sc_err("%s: Failed to register device\n", __func__);
+		input_free_device(dev);
+		return ret;
+	}
+
+	sc->icc.pwrbutton_dev = dev;
+
+	// enable power button notifications
+	button = 0x100;
+	ret = ps4sb_icc_cmd(8, 1, &button, sizeof(button), NULL, 0);
+	if (ret < 0) {
+		sc_info("%s: Failed to enable power notifications (%d)\n",
+			__func__, ret);
+	}
+
+	// enable reset button notifications (?)
+	button = 0x102;
+	ret = ps4sb_icc_cmd(8, 1, &button, sizeof(button), NULL, 0);
+	if (ret < 0) {
+		sc_info("%s: Failed to enable reset notifications (%d)\n",
+		        __func__, ret);
+	}
+
+	return 0;
+}
+
+void icc_pwrbutton_remove(struct ps4sb_dev *sc)
+{
+	if (sc->icc.pwrbutton_dev)
+		input_unregister_device(sc->icc.pwrbutton_dev);
+	sc->icc.pwrbutton_dev = NULL;
+}
diff --git a/drivers/ps4/sb-sflash.c b/drivers/ps4/sb-sflash.c
new file mode 100644
index 0000000000000000000000000000000000000000..1983770fed4c689f8a78a163386e250b7915b0a7
--- /dev/null
+++ b/drivers/ps4/sb-sflash.c
@@ -0,0 +1,546 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define pr_fmt(fmt) "ps4-sflash: " fmt
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/pci.h>
+#include <linux/io.h>
+#include <linux/delay.h>
+#include <linux/iopoll.h>
+#include <linux/sched.h>
+#include <linux/fs.h>
+#include <linux/miscdevice.h>
+#include <linux/uaccess.h>
+#include <linux/mutex.h>
+#include <linux/dma-mapping.h>
+#include <linux/slab.h>
+
+#include "sb-sflash.h"
+
+struct ps4_sflash_dev;
+
+struct ps4_sflash_chip {
+	const char *name;
+	int (*setup)(struct ps4_sflash_dev *dev);
+	u32 (*read_jedec)(struct ps4_sflash_dev *dev);
+	u32 (*read_status)(struct ps4_sflash_dev *dev);
+	ssize_t (*read_block)(struct ps4_sflash_dev *dev, u32 flash_addr,
+			      u8 *out_buf, size_t flash_len);
+};
+
+struct ps4_sflash_dev {
+	struct pci_dev *pdev;
+	const struct ps4_sflash_chip *chip;
+	void __iomem *bar4;
+	void __iomem *sflash_regs;
+	void __iomem *clk_regs;
+	struct miscdevice misc;
+	struct mutex lock;
+	u8 *dma_vaddr;
+	dma_addr_t dma_paddr;
+	u8 *dec_buf;
+};
+
+static struct ps4_sflash_dev *g_ps4_sflash;
+
+static inline u32 sflash_read32(struct ps4_sflash_dev *dev, u32 reg)
+{
+	return ioread32(dev->sflash_regs + reg);
+}
+
+static inline void sflash_write32(struct ps4_sflash_dev *dev, u32 reg, u32 val)
+{
+	iowrite32(val, dev->sflash_regs + reg);
+}
+
+static inline u32 sflash_clk_read32(struct ps4_sflash_dev *dev, u32 reg)
+{
+	return ioread32(dev->clk_regs + reg);
+}
+
+static inline void sflash_clk_write32(struct ps4_sflash_dev *dev, u32 reg, u32 val)
+{
+	iowrite32(val, dev->clk_regs + reg);
+}
+
+static int ps4_sflash_clk_enable(struct ps4_sflash_dev *dev)
+{
+	int timeout = 1000;
+
+	sflash_clk_write32(dev, 0x4, 1);
+	while (timeout--) {
+		if ((sflash_clk_read32(dev, 0x0) & 7) == 4)
+			return 0;
+		usleep_range(50, 100);
+	}
+	return -ETIMEDOUT;
+}
+
+static int ps4_sflash_wait_idle(struct ps4_sflash_dev *dev)
+{
+	int timeout = 10000;
+
+	while (timeout--) {
+		if ((sflash_read32(dev, PS4_SFLASH_REG_STATUS) & 1) == 0)
+			return 0;
+		udelay(10);
+	}
+	return -ETIMEDOUT;
+}
+
+static int ps4_sflash_wait_dma(struct ps4_sflash_dev *dev)
+{
+	int timeout = 10000;
+
+	while (timeout--) {
+		if ((sflash_read32(dev, PS4_SFLASH_REG_CMD) & 0x80000000) == 0)
+			return 0;
+		udelay(10);
+	}
+	return -ETIMEDOUT;
+}
+
+static u32 ps4_sflash_read_jedec(struct ps4_sflash_dev *dev)
+{
+	ps4_sflash_clk_enable(dev);
+	sflash_write32(dev, PS4_SFLASH_REG_CMD, 0x8010009f);
+	ps4_sflash_wait_idle(dev);
+	return sflash_read32(dev, PS4_SFLASH_REG_RDID);
+}
+
+static u32 ps4_sflash_read_status(struct ps4_sflash_dev *dev)
+{
+	ps4_sflash_clk_enable(dev);
+	sflash_write32(dev, PS4_SFLASH_REG_CMD, 0x80000005);
+	ps4_sflash_wait_idle(dev);
+	return (sflash_read32(dev, PS4_SFLASH_REG_STATUS) >> 16) & 0xff;
+}
+
+static void ps4_sflash_unpack_chunk(const u8 *raw, u8 *dec, size_t raw_len)
+{
+	size_t i;
+
+	for (i = 0; i < raw_len; i += 4) {
+		u8 b0 = raw[i];
+		u8 b1 = raw[i + 1];
+		u8 b2 = raw[i + 2];
+		u8 b3 = raw[i + 3];
+
+		dec[i / 4] = ((b0 & 0x20) << 2) |
+			     ((b0 & 0x02) << 5) |
+			     ((b1 & 0x20) << 0) |
+			     ((b1 & 0x02) << 3) |
+			     ((b2 & 0x20) >> 2) |
+			     ((b2 & 0x02) << 1) |
+			     ((b3 & 0x20) >> 4) |
+			     ((b3 & 0x02) >> 1);
+	}
+}
+
+static ssize_t ps4_sflash_read_block(struct ps4_sflash_dev *dev, u32 flash_addr,
+				     u8 *out_buf, size_t flash_len)
+{
+	size_t dma_len = flash_len * 4;
+	u32 ctrl_addr = (flash_addr - 1) & 0xffffffff;
+	int ret;
+
+	if (dma_len > PS4_SFLASH_CHUNK_DMA)
+		return -EINVAL;
+
+	ret = ps4_sflash_clk_enable(dev);
+	if (ret)
+		return ret;
+
+	sflash_write32(dev, PS4_SFLASH_REG_TIMING, 0x007d0000);
+	sflash_write32(dev, PS4_SFLASH_REG_OPCODES, 0x9f050300);
+	sflash_write32(dev, PS4_SFLASH_REG_CS,
+		       (sflash_read32(dev, PS4_SFLASH_REG_CS) & 0xffffff00) | 1);
+
+	sflash_write32(dev, PS4_SFLASH_REG_STATUS_CLR, 0);
+	sflash_write32(dev, PS4_SFLASH_REG_OFFSET, ctrl_addr);
+	sflash_write32(dev, PS4_SFLASH_REG_DMA_ADDR, (u32)dev->dma_paddr);
+	sflash_write32(dev, PS4_SFLASH_REG_DMA_LEN, 0x80000000 | (u32)dma_len);
+	sflash_write32(dev, PS4_SFLASH_REG_CMD, 0x82100103);
+
+	ret = ps4_sflash_wait_dma(dev);
+	if (ret)
+		return ret;
+
+	ps4_sflash_unpack_chunk(dev->dma_vaddr, out_buf, dma_len);
+	return flash_len;
+}
+
+static int ps4_sflash_aeolia_setup(struct ps4_sflash_dev *dev)
+{
+	dev->sflash_regs = dev->bar4 + 0xc2000;
+	dev->clk_regs = dev->bar4 + 0xc3000;
+
+	dma_set_mask_and_coherent(&dev->pdev->dev, DMA_BIT_MASK(32));
+	dev->dma_vaddr = dma_alloc_coherent(&dev->pdev->dev, PS4_SFLASH_CHUNK_DMA,
+					    &dev->dma_paddr, GFP_KERNEL);
+	if (!dev->dma_vaddr) {
+		pr_err("failed to allocate DMA bounce buffer\n");
+		return -ENOMEM;
+	}
+	return 0;
+}
+
+static int ps4_sflash_baikal_claim(struct ps4_sflash_dev *dev)
+{
+	u32 val;
+	int ret;
+
+	sflash_write32(dev, PS4_SFLASH_BK_CLAIM, 1);
+	ret = read_poll_timeout(ioread32, val, (val & 7) == 4, 10,
+				PS4_SFLASH_BK_TIMEOUT_US, false,
+				dev->sflash_regs + PS4_SFLASH_BK_CLAIM_STATUS);
+	if (ret) {
+		sflash_write32(dev, PS4_SFLASH_BK_CLAIM, 0);
+		return ret;
+	}
+	return 0;
+}
+
+static void ps4_sflash_baikal_release(struct ps4_sflash_dev *dev)
+{
+	u32 val;
+
+	sflash_write32(dev, PS4_SFLASH_BK_CLAIM, 0);
+	if (read_poll_timeout(ioread32, val, !(val & 4), 10,
+			      PS4_SFLASH_BK_TIMEOUT_US, false,
+			      dev->sflash_regs + PS4_SFLASH_BK_CLAIM_STATUS))
+		pr_warn_ratelimited("release timed out, status %08x\n", val);
+}
+
+static int ps4_sflash_baikal_xfer(struct ps4_sflash_dev *dev, u8 opcode,
+				  u32 addr, unsigned int addr_len,
+				  u8 *rx, unsigned int rx_len)
+{
+	unsigned int i;
+	u32 val;
+	int ret;
+
+	sflash_write32(dev, PS4_SFLASH_BK_OPCODE, opcode);
+	for (i = 0; i < PS4_SFLASH_BK_ADDR_LEN; i++)
+		sflash_write32(dev, PS4_SFLASH_BK_ADDR - i * 4,
+			       addr_len ? (addr >> (24 - i * 8)) & 0xff : 0);
+	sflash_write32(dev, PS4_SFLASH_BK_BITS, (1 + addr_len + rx_len) * 8);
+	sflash_write32(dev, PS4_SFLASH_BK_CTRL, PS4_SFLASH_BK_CTRL_START);
+
+	ret = read_poll_timeout(ioread32, val, !(val & PS4_SFLASH_BK_CTRL_START),
+				0, PS4_SFLASH_BK_TIMEOUT_US, false,
+				dev->sflash_regs + PS4_SFLASH_BK_CTRL);
+	if (!ret)
+		for (i = 0; i < rx_len; i++)
+			rx[i] = sflash_read32(dev, PS4_SFLASH_BK_RX + i * 4);
+
+	sflash_write32(dev, PS4_SFLASH_BK_CTRL, 0);
+	return ret;
+}
+
+static int ps4_sflash_baikal_command(struct ps4_sflash_dev *dev, u8 opcode,
+				     u8 *rx, unsigned int rx_len)
+{
+	int ret;
+
+	ret = ps4_sflash_baikal_claim(dev);
+	if (ret)
+		return ret;
+
+	ret = ps4_sflash_baikal_xfer(dev, opcode, 0, 0, rx, rx_len);
+	ps4_sflash_baikal_release(dev);
+	return ret;
+}
+
+static u32 ps4_sflash_baikal_read_jedec(struct ps4_sflash_dev *dev)
+{
+	u8 rx[3];
+
+	if (ps4_sflash_baikal_command(dev, PS4_SFLASH_BK_OP_RDID, rx, sizeof(rx)))
+		return ~0u;
+	return rx[0] | rx[1] << 8 | rx[2] << 16;
+}
+
+static u32 ps4_sflash_baikal_read_status(struct ps4_sflash_dev *dev)
+{
+	u8 rx;
+
+	if (ps4_sflash_baikal_command(dev, PS4_SFLASH_BK_OP_RDSR, &rx, 1))
+		return ~0u;
+	return rx;
+}
+
+static ssize_t ps4_sflash_baikal_read_block(struct ps4_sflash_dev *dev,
+					    u32 flash_addr, u8 *out_buf,
+					    size_t flash_len)
+{
+	size_t i;
+	int ret;
+
+	ret = ps4_sflash_baikal_claim(dev);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < flash_len; i++) {
+		ret = ps4_sflash_baikal_xfer(dev, PS4_SFLASH_BK_OP_READ4B,
+					     flash_addr + i, 4, &out_buf[i], 1);
+		if (ret)
+			break;
+		cond_resched();
+	}
+
+	ps4_sflash_baikal_release(dev);
+	return ret ? ret : flash_len;
+}
+
+static int ps4_sflash_baikal_setup(struct ps4_sflash_dev *dev)
+{
+	u32 val;
+	int ret;
+
+	dev->sflash_regs = dev->bar4;
+
+	ret = ps4_sflash_baikal_claim(dev);
+	if (ret) {
+		pr_err("controller claim timed out\n");
+		return ret;
+	}
+
+	sflash_write32(dev, PS4_SFLASH_BK_UNLOCK, 1);
+	val = sflash_read32(dev, PS4_SFLASH_BK_PINS);
+	sflash_write32(dev, PS4_SFLASH_BK_PINS, val & ~PS4_SFLASH_BK_PINS_CLEAR);
+	sflash_write32(dev, PS4_SFLASH_BK_UNLOCK, 0);
+
+	sflash_write32(dev, PS4_SFLASH_BK_IRQ_STATUS, 0xff);
+	sflash_write32(dev, PS4_SFLASH_BK_DMA_IRQ_STATUS, 0);
+	sflash_write32(dev, PS4_SFLASH_BK_IRQ_MASK, 0);
+	sflash_write32(dev, PS4_SFLASH_BK_DMA_IRQ_MASK, 0);
+	sflash_write32(dev, PS4_SFLASH_BK_TIMING, 0x30);
+	sflash_write32(dev, PS4_SFLASH_BK_CFG,
+		       sflash_read32(dev, PS4_SFLASH_BK_CFG) | PS4_SFLASH_BK_CFG_ENABLE);
+
+	ps4_sflash_baikal_release(dev);
+	return 0;
+}
+
+static const struct ps4_sflash_chip ps4_sflash_aeolia = {
+	.name		= "Aeolia",
+	.setup		= ps4_sflash_aeolia_setup,
+	.read_jedec	= ps4_sflash_read_jedec,
+	.read_status	= ps4_sflash_read_status,
+	.read_block	= ps4_sflash_read_block,
+};
+
+static const struct ps4_sflash_chip ps4_sflash_baikal = {
+	.name		= "Baikal",
+	.setup		= ps4_sflash_baikal_setup,
+	.read_jedec	= ps4_sflash_baikal_read_jedec,
+	.read_status	= ps4_sflash_baikal_read_status,
+	.read_block	= ps4_sflash_baikal_read_block,
+};
+
+static const struct {
+	u16 device;
+	const struct ps4_sflash_chip *chip;
+} ps4_sflash_pci_ids[] = {
+	{ 0x90a1, &ps4_sflash_aeolia },
+	{ 0x90b8, &ps4_sflash_aeolia },
+	{ 0x90c4, &ps4_sflash_aeolia },
+	{ 0x90d4, &ps4_sflash_aeolia },
+	{ PCI_DEVICE_ID_SONY_BAIKAL_PCIE, &ps4_sflash_baikal },
+};
+
+static ssize_t ps4_sflash_read(struct file *file, char __user *buf,
+			       size_t count, loff_t *ppos)
+{
+	struct ps4_sflash_dev *dev = g_ps4_sflash;
+	size_t total_read = 0;
+	ssize_t ret = 0;
+
+	if (!dev)
+		return -ENODEV;
+
+	if (*ppos >= PS4_SFLASH_TOTAL_SIZE)
+		return 0;
+
+	if (*ppos + count > PS4_SFLASH_TOTAL_SIZE)
+		count = PS4_SFLASH_TOTAL_SIZE - *ppos;
+
+	if (mutex_lock_interruptible(&dev->lock))
+		return -ERESTARTSYS;
+
+	while (count > 0) {
+		u32 chunk_flash_off = (u32)(*ppos & ~(PS4_SFLASH_CHUNK_FLASH - 1));
+		u32 offset_in_chunk = (u32)(*ppos & (PS4_SFLASH_CHUNK_FLASH - 1));
+		size_t to_copy = PS4_SFLASH_CHUNK_FLASH - offset_in_chunk;
+
+		if (to_copy > count)
+			to_copy = count;
+
+		ret = dev->chip->read_block(dev, chunk_flash_off, dev->dec_buf,
+					    PS4_SFLASH_CHUNK_FLASH);
+		if (ret < 0)
+			break;
+
+		if (copy_to_user(buf + total_read, dev->dec_buf + offset_in_chunk, to_copy)) {
+			ret = -EFAULT;
+			break;
+		}
+
+		*ppos += to_copy;
+		total_read += to_copy;
+		count -= to_copy;
+	}
+
+	mutex_unlock(&dev->lock);
+	return total_read ? (ssize_t)total_read : ret;
+}
+
+static loff_t ps4_sflash_llseek(struct file *file, loff_t offset, int whence)
+{
+	return fixed_size_llseek(file, offset, whence, PS4_SFLASH_TOTAL_SIZE);
+}
+
+static long ps4_sflash_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct ps4_sflash_dev *dev = g_ps4_sflash;
+	u32 val;
+	int ret = 0;
+
+	if (!dev)
+		return -ENODEV;
+
+	if (mutex_lock_interruptible(&dev->lock))
+		return -ERESTARTSYS;
+
+	switch (cmd) {
+	case PS4_SFLASH_IOC_GET_SIZE:
+		val = PS4_SFLASH_TOTAL_SIZE;
+		if (copy_to_user((void __user *)arg, &val, sizeof(val)))
+			ret = -EFAULT;
+		break;
+	case PS4_SFLASH_IOC_GET_JEDEC:
+		val = dev->chip->read_jedec(dev);
+		if (copy_to_user((void __user *)arg, &val, sizeof(val)))
+			ret = -EFAULT;
+		break;
+	case PS4_SFLASH_IOC_GET_STATUS:
+		val = dev->chip->read_status(dev);
+		if (copy_to_user((void __user *)arg, &val, sizeof(val)))
+			ret = -EFAULT;
+		break;
+	default:
+		ret = -ENOTTY;
+		break;
+	}
+
+	mutex_unlock(&dev->lock);
+	return ret;
+}
+
+static const struct file_operations ps4_sflash_fops = {
+	.owner          = THIS_MODULE,
+	.read           = ps4_sflash_read,
+	.llseek         = ps4_sflash_llseek,
+	.unlocked_ioctl = ps4_sflash_ioctl,
+};
+
+static int __init ps4_sflash_init(void)
+{
+	struct ps4_sflash_dev *dev;
+	struct pci_dev *pdev = NULL;
+	int i, ret;
+	u32 jedec;
+
+	for (i = 0; i < ARRAY_SIZE(ps4_sflash_pci_ids); i++) {
+		pdev = pci_get_device(PCI_VENDOR_ID_SONY,
+				      ps4_sflash_pci_ids[i].device, NULL);
+		if (pdev)
+			break;
+	}
+
+	if (!pdev)
+		return -ENODEV;
+
+	dev = kzalloc(sizeof(*dev), GFP_KERNEL);
+	if (!dev) {
+		pci_dev_put(pdev);
+		return -ENOMEM;
+	}
+
+	dev->pdev = pdev;
+	dev->chip = ps4_sflash_pci_ids[i].chip;
+	mutex_init(&dev->lock);
+
+	dev->bar4 = pci_iomap(pdev, 4, 0x200000);
+	if (!dev->bar4) {
+		pr_err("failed to map southbridge BAR4\n");
+		ret = -ENOMEM;
+		goto err_free;
+	}
+
+	dev->dec_buf = kmalloc(PS4_SFLASH_CHUNK_FLASH, GFP_KERNEL);
+	if (!dev->dec_buf) {
+		ret = -ENOMEM;
+		goto err_unmap;
+	}
+
+	ret = dev->chip->setup(dev);
+	if (ret)
+		goto err_free_dec;
+
+	dev->misc.minor = MISC_DYNAMIC_MINOR;
+	dev->misc.name  = "ps4sflash";
+	dev->misc.fops  = &ps4_sflash_fops;
+	ret = misc_register(&dev->misc);
+	if (ret) {
+		pr_err("failed to register misc device\n");
+		goto err_free_dma;
+	}
+
+	g_ps4_sflash = dev;
+	jedec = dev->chip->read_jedec(dev);
+
+	pr_info("%s Southbridge SPI NOR flash driver initialized\n", dev->chip->name);
+	pr_info("JEDEC ID: 0x%08x, Size: 32MB\n", jedec);
+	pr_info("Userspace device registered (/dev/ps4sflash)\n");
+	return 0;
+
+err_free_dma:
+	if (dev->dma_vaddr)
+		dma_free_coherent(&pdev->dev, PS4_SFLASH_CHUNK_DMA, dev->dma_vaddr, dev->dma_paddr);
+err_free_dec:
+	kfree(dev->dec_buf);
+err_unmap:
+	pci_iounmap(pdev, dev->bar4);
+err_free:
+	pci_dev_put(pdev);
+	kfree(dev);
+	return ret;
+}
+
+static void __exit ps4_sflash_exit(void)
+{
+	struct ps4_sflash_dev *dev = g_ps4_sflash;
+
+	if (!dev)
+		return;
+
+	misc_deregister(&dev->misc);
+	if (dev->dma_vaddr)
+		dma_free_coherent(&dev->pdev->dev, PS4_SFLASH_CHUNK_DMA, dev->dma_vaddr, dev->dma_paddr);
+	kfree(dev->dec_buf);
+	pci_iounmap(dev->pdev, dev->bar4);
+	pci_dev_put(dev->pdev);
+	kfree(dev);
+	g_ps4_sflash = NULL;
+}
+
+module_init(ps4_sflash_init);
+module_exit(ps4_sflash_exit);
+
+MODULE_AUTHOR("Armandas Kvietkus <armandas.kvietkus@proton.me>");
+MODULE_DESCRIPTION("PS4 Southbridge Hardware SPI NOR Flash Driver");
+MODULE_LICENSE("GPL");
