+
+	AEOLIA_NUM_SUBFUNCS	= 23
+};
+
+#define AEOLIA_NR_UARTS 2
+
+/* Relative to BAR2 */
+#define AEOLIA_RGN_RTC_BASE		0x0
+#define AEOLIA_RGN_RTC_SIZE		0x1000
+
+#define AEOLIA_RGN_CHIPID_BASE		0x1000
+#define AEOLIA_RGN_CHIPID_SIZE		0x1000
+
+#define AEOLIA_REG_CHIPID_0		0x1104
+#define AEOLIA_REG_CHIPID_1		0x1108
+#define AEOLIA_REG_CHIPREV		0x110c
+
+/* Relative to BAR4 */
+#define AEOLIA_RGN_UART_BASE		0x140000
+#define AEOLIA_RGN_UART_SIZE		0x1000
+
+#define AEOLIA_RGN_PCIE_BASE		0x1c8000
+#define AEOLIA_RGN_PCIE_SIZE		0x1000
+
+#define AEOLIA_RGN_ICC_BASE		0x184000
+#define AEOLIA_RGN_ICC_SIZE		0x1000
+
+#define AEOLIA_REG_BAR(x)		(AEOLIA_RGN_PCIE_BASE + (x))
+#define AEOLIA_REG_BAR_MASK(func, bar)	AEOLIA_REG_BAR(((func) * 0x30) + \
+						((bar) << 3))
+#define AEOLIA_REG_BAR_ADDR(func, bar)	AEOLIA_REG_BAR(((func) * 0x30) + \
+						((bar) << 3) + 0x4)
+
+#define AEOLIA_REG_MSI(x)		(AEOLIA_RGN_PCIE_BASE + 0x400 + (x))
+#define AEOLIA_REG_MSI_CONTROL		AEOLIA_REG_MSI(0x0)
+#define AEOLIA_REG_MSI_MASK(func)	AEOLIA_REG_MSI(0x4c + ((func) << 2))
+#define AEOLIA_REG_MSI_DATA_HI(func)	AEOLIA_REG_MSI(0x8c + ((func) << 2))
+#define AEOLIA_REG_MSI_ADDR(func)	AEOLIA_REG_MSI(0xac + ((func) << 2))
+/* This register has non-uniform structure per function, dealt with in code */
+#define AEOLIA_REG_MSI_DATA_LO(off)	AEOLIA_REG_MSI(0x100 + (off))
+
+/* Not sure what the two individual bits do */
+#define AEOLIA_REG_MSI_CONTROL_ENABLE	0x05
+
+/* Enable for the entire function, 4 is special */
+#define AEOLIA_REG_MSI_MASK_FUNC		0x01000000
+#define AEOLIA_REG_MSI_MASK_FUNC4	0x80000000
+
+#define AEOLIA_REG_ICC(x)		(AEOLIA_RGN_ICC_BASE + (x))
+#define AEOLIA_REG_ICC_DOORBELL		AEOLIA_REG_ICC(0x804)
+#define AEOLIA_REG_ICC_STATUS		AEOLIA_REG_ICC(0x814)
+#define AEOLIA_REG_ICC_IRQ_MASK		AEOLIA_REG_ICC(0x824)
+
+/* Apply to both DOORBELL and STATUS */
+#define AEOLIA_ICC_SEND			0x01
+#define AEOLIA_ICC_ACK			0x02
+
+/* Relative to func6 BAR5 */
+#define AEOLIA_SPM_ICC_BASE		0x2c000
+#define AEOLIA_SPM_ICC_SIZE		0x1000
+
+/* Boot params passed from southbridge */
+#define AEOLIA_SPM_BP_BASE		0x2f000
+#define AEOLIA_SPM_BP_SIZE		0x20
+
+#define AEOLIA_SPM_ICC_REQUEST		0x0
+#define AEOLIA_SPM_ICC_REPLY		0x800
+
+
+enum baikal_func_id {
+	BAIKAL_FUNC_ID_ACPI = 0,
+	BAIKAL_FUNC_ID_GBE,
+	BAIKAL_FUNC_ID_AHCI,
+	BAIKAL_FUNC_ID_SDHCI,
+	BAIKAL_FUNC_ID_PCIE,
+	BAIKAL_FUNC_ID_DMAC,
+	BAIKAL_FUNC_ID_MEM,
+	BAIKAL_FUNC_ID_XHCI,
+
+	BAIKAL_NUM_FUNCS
+};
+
+enum baikal_subfuncs_per_func {
+	SUBFUNCS_PER_FUNC4 = 31,
+	SUBFUNCS_PER_FUNC2 = 1,
+	SUBFUNCS_PER_FUNC7 = 3,
+	SUBFUNCS_PER_FUNC0 = 2,
+	SUBFUNCS_PER_FUNC1 = 1,
+	SUBFUNCS_PER_FUNC3 = 1,
+	SUBFUNCS_PER_FUNC5 = 2,
+	SUBFUNCS_PER_FUNC6 = 3,
+};
+
+enum baikal_subfunc {
+	BAIKAL_SUBFUNC_GLUE	= 0,
+	BAIKAL_SUBFUNC_ICC	= 3,
+	BAIKAL_SUBFUNC_HPET	= 22,
+	BAIKAL_SUBFUNC_SFLASH	= 19,
+	BAIKAL_SUBFUNC_RTC	= 21,
+	BAIKAL_SUBFUNC_UART0	= 26,
+	BAIKAL_SUBFUNC_UART1	= 27,
+
+	BAIKAL_SUBFUNC_USB0	= 0, BAIKAL_SUBFUNC_USB2 = 2,
+	BAIKAL_SUBFUNC_ACPI= 1,
+	BAIKAL_SUBFUNC_SPM = 1,
+	BAIKAL_SUBFUNC_DMAC1	= 0,
+	BAIKAL_SUBFUNC_DMAC2	= 1,
+	BAIKAL_NUM_SUBFUNCS	= 32
+};
+
+#define BAIKAL_NR_UARTS 1
+
+#define BAIKAL_RGN_CHIPID_BASE		0x4000
+#define BAIKAL_RGN_CHIPID_SIZE		0x9000
+
+#define BAIKAL_REG_CHIPID_0		0xC020
+#define BAIKAL_REG_CHIPID_1		0xC024
+#define BAIKAL_REG_CHIPREV		0x4084
+
+#define BAIKAL_HPET_BASE         0x109000
+#define BAIKAL_HPET_SIZE         0x400
+
+#define BAIKAL_RGN_UART_BASE		0x10E000
+#define BAIKAL_RGN_UART_SIZE		0x1000
+#define BAIKAL_RGN_ICC_BASE		(0x108000 - 0x800)
+#define BAIKAL_RGN_ICC_SIZE		0x1000
+
+#define BAIKAL_ACK_WRITE 		0x110084
+#define BAIKAL_ACK_READ  		0x110088
+
+#define BAIKAL_REG_ICC(x)		(BAIKAL_RGN_ICC_BASE + (x))
+#define BAIKAL_REG_ICC_DOORBELL		BAIKAL_REG_ICC(0x804)
+#define BAIKAL_REG_ICC_STATUS		BAIKAL_REG_ICC(0x814)
+#define BAIKAL_REG_ICC_IRQ_MASK		BAIKAL_REG_ICC(0x824)
+
+#define BAIKAL_ICC_SEND			0x01
+#define BAIKAL_ICC_ACK			0x02
+
+#define BAIKAL_USB_BASE			0x180000
+
+#define BAIKAL_SPM_ICC_BASE		0x2c000
+#define BAIKAL_SPM_ICC_SIZE		0x1000
+
+#define BAIKAL_SPM_BP_BASE		0x2f000
+#define BAIKAL_SPM_BP_SIZE		0x20
+
+#define BAIKAL_SPM_ICC_REQUEST		0x0
+#define BAIKAL_SPM_ICC_REPLY		0x800
+
+
+#define CHAR_BIT 8
+static inline u32 rol (u32 n, unsigned int c) {
+	const unsigned int mask = (CHAR_BIT*sizeof(n) - 1);
+
+	c &= mask;
+	return (n<<c) | (n>>( (-c)&mask ));
+}
+
+static inline u32 ror (u32 n, unsigned int c) {
+	const unsigned int mask = (CHAR_BIT*sizeof(n) - 1);
+
+	c &= mask;
+	return (n>>c) | (n<<( (-c)&mask ));
+}
+
+static inline void cpu_stop(void)
+{
+    for (;;)
+        asm volatile("cli; hlt;" : : : "memory");
+}
+
+static inline void stop_hpet_timers(struct ps4sb_dev *sc) {
+		*(volatile u64 *)(sc->bar2 + BAIKAL_HPET_BASE + 0x10) &= ~(1UL << 0);
+		u64 NUM_TIM_CAP;
+		NUM_TIM_CAP = *(volatile u64 *)(sc->bar2 + BAIKAL_HPET_BASE) & 0x1F00;
+		u64 N;
+		for (N = 0; N <= NUM_TIM_CAP; N++) {
+			*(volatile u64 *)(sc->bar2 + BAIKAL_HPET_BASE + (0x20*N) + 0x100) &= ~(1UL << 2);
+		}
+		cpu_stop();
+}
+
+static inline int pci_pm_stop(struct pci_dev *dev)
+{
+	u16 csr;
+
+	if (!dev->pm_cap)
+		return -ENOTTY;
+
+	pci_read_config_word(dev, dev->pm_cap + PCI_PM_CTRL, &csr);
+
+	csr &= ~PCI_PM_CTRL_STATE_MASK;
+	csr |= PCI_D3hot;
+	pci_write_config_word(dev, dev->pm_cap + PCI_PM_CTRL, csr);
+
+	return 0;
+}
+
+static inline void pci_pm_stop_all(struct pci_dev *dev)
+{
+	struct pci_dev *sc_dev;
+	unsigned int func;
+	for (func = 0; func < 8; ++func) {
+		sc_dev = pci_get_slot(pci_find_bus(pci_domain_nr(dev->bus), 0), PCI_DEVFN(20, func));
+		pci_pm_stop(sc_dev);
+	}
+	cpu_stop();
+}
+
+int baikal_is_compatible_device(struct pci_dev *dev);
+int baikal_sata_phy_init(struct pci_dev *pdev, void __iomem *ahci_mmio);
+
 #endif
diff --git a/drivers/ps4/sb-aeolia.c b/drivers/ps4/sb-aeolia.c
new file mode 100644
index 0000000000000000000000000000000000000000..08cc71e3c6fdae1b7d6bc12baa2a979eeef45470
--- /dev/null
+++ b/drivers/ps4/sb-aeolia.c
@@ -0,0 +1,713 @@
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/pci.h>
+#include <linux/init.h>
+#include <linux/irq.h>
+#include <linux/irqchip.h>
+#include <linux/irqdomain.h>
+#include <linux/msi.h>
+#include <asm/apic.h>
+#include <asm/irqdomain.h>
+#include <asm/irq_remapping.h>
+
+#include <asm/msi.h>
+
+#include <asm/ps4.h>
+
+#include "ps4sb.h"
+
+
+#define     MSI_DATA_VECTOR_SHIFT	0
+#define	    MSI_DATA_VECTOR(v)		(((u8)v) << MSI_DATA_VECTOR_SHIFT)
+#define     MSI_DATA_VECTOR_MASK	0xffffff00
+
+/* #define QEMU_HACK_NO_IOMMU */
+
+/* Number of implemented MSI registers per function */
+static const int subfuncs_per_func[AEOLIA_NUM_FUNCS] = {
+	4, 4, 4, 4, 31, 2, 2, 4
+};
+
+struct aeolia_irq_data {
+	struct ps4sb_dev *sc;
+	u8 msi_data;
+};
+
+struct ps4sb_msi_domain_ctx {
+	struct irq_chip controller;
+	struct msi_domain_info info;
+};
+
+static inline u32 glue_read32(struct ps4sb_dev *sc, u32 offset) {
+	return ioread32(sc->bar4 + offset);
+}
+
+static inline void glue_write32(struct ps4sb_dev *sc, u32 offset, u32 value) {
+	iowrite32(value, sc->bar4 + offset);
+}
+
+static inline void glue_set_region(struct ps4sb_dev *sc, u32 func, u32 bar,
+			    u32 base, u32 mask) {
+	glue_write32(sc, AEOLIA_REG_BAR_MASK(func, bar), mask);
+	glue_write32(sc, AEOLIA_REG_BAR_ADDR(func, bar), base);
+}
+
+static inline void glue_set_mask(struct ps4sb_dev *sc, u32 offset, u32 mask) {
+	void __iomem *ptr = sc->bar4 + offset;
+	iowrite32(ioread32(ptr) | mask, ptr);
+}
+
+static inline void glue_clear_mask(struct ps4sb_dev *sc, u32 offset, u32 mask) {
+	void __iomem *ptr = sc->bar4 + offset;
+	iowrite32(ioread32(ptr) & ~mask, ptr);
+}
+
+static inline void glue_mask_and_set(struct ps4sb_dev *sc, u32 offset, u32 mask, u32 set) {
+	void __iomem *ptr = sc->bar4 + offset;
+	iowrite32((ioread32(ptr) & ~mask) | set, ptr);
+}
+
+static void aeolia_config_msi(struct ps4sb_dev *sc, u32 func, u32 subfunc,
+			     u32 addr, u32 data) {
+	u32 offset;
+
+	sc_dbg("aeolia_config_msi: func: %u, subfunc: %u, addr %08x data: 0x%08x (%u)\n",
+		func, subfunc, addr, data, data);
+
+	glue_clear_mask(sc, AEOLIA_REG_MSI_CONTROL, AEOLIA_REG_MSI_CONTROL_ENABLE);
+	/* Unknown */
+	sc_dbg("glue_write32 to offset, value (%px, %08x, %08x)\n", sc->bar4, AEOLIA_REG_MSI(0x8), 0xffffffff);
+	glue_write32(sc, AEOLIA_REG_MSI(0x8), 0xffffffff);
+	/* Unknown */
+	sc_dbg("glue_write32 to offset, value (%px, %08x, %08x)\n", sc->bar4, AEOLIA_REG_MSI(0xc + (func << 2)), 0xB7FFFF00 + func * 16);
+	glue_write32(sc, AEOLIA_REG_MSI(0xc + (func << 2)), 0xB7FFFF00 + func * 16);
+
+	sc_dbg("glue_write32 to offset, value (%px, %08x, %08x)\n", sc->bar4, AEOLIA_REG_MSI_ADDR(func), addr);
+	glue_write32(sc, AEOLIA_REG_MSI_ADDR(func), addr);
+	/* Unknown */
+
+	sc_dbg("glue_write32 to offset, value (%px, %08x, %08x)\n", sc->bar4, AEOLIA_REG_MSI(0xcc + (func << 2)), 0);
+	glue_write32(sc, AEOLIA_REG_MSI(0xcc + (func << 2)), 0);
+
+	sc_dbg("glue_write32 to offset, value (%px, %08x, %08x)\n", sc->bar4, AEOLIA_REG_MSI_DATA_HI(func),  data & 0xffe0);
+	glue_write32(sc, AEOLIA_REG_MSI_DATA_HI(func), data & 0xffe0);
+
+	if (func < 4) {
+		/* First 4 functions have 4 IRQs/subfuncs each */
+		offset = (func << 4) | (subfunc << 2);
+	} else if (func == 4) {
+		/* Function 4 gets 24 consecutive slots,
+		 * then 7 more at the end. */
+		if (subfunc < 24)
+			offset = 0x40 + (subfunc << 2);
+		else
+			offset = 0xe0 + ((subfunc - 24) << 2);
+	} else {
+		offset = 0xa0 + ((func - 5) << 4) + (subfunc << 2);
+	}
+
+	sc_dbg("glue_write32 to offset, value (%px, %08x, %08x)\n", sc->bar4,  AEOLIA_REG_MSI_DATA_LO(offset), data & 0x1f);
+	glue_write32(sc, AEOLIA_REG_MSI_DATA_LO(offset), data & 0x1f);
+
+	if (func == AEOLIA_FUNC_ID_PCIE)
+		glue_set_mask(sc, AEOLIA_REG_MSI_MASK(func), AEOLIA_REG_MSI_MASK_FUNC4);
+	else
+		glue_set_mask(sc, AEOLIA_REG_MSI_MASK(func), AEOLIA_REG_MSI_MASK_FUNC);
+
+	glue_set_mask(sc, AEOLIA_REG_MSI_CONTROL, AEOLIA_REG_MSI_CONTROL_ENABLE);
+}
+
+static void aeolia_msi_write_msg(struct irq_data *data, struct msi_msg *msg)
+{
+	struct aeolia_irq_data *irq_data = data->chip_data;
+	struct ps4sb_dev *sc = irq_data->sc;
+	u32 func = data->hwirq >> 8;
+	u32 subfunc = data->hwirq & 0xff;
+
+	/* Linux likes to unconfigure MSIs like this, but since we share the
+	 * address between subfunctions, we can't do that. The IRQ should be
+	 * masked via aeolia_msi_mask anyway, so just do nothing. */
+	if (!msg->address_lo) {
+		return;
+	}
+
+	sc_dbg("aeolia_msi_write_msg(%08x, %08x) mask=0x%x irq=%d hwirq=0x%lx %p\n",
+	       msg->address_lo, msg->data, data->mask, data->irq, data->hwirq, sc);
+
+	if (subfunc == 0xff) {
+		int i;
+		for (i = 0; i < subfuncs_per_func[func]; i++)
+			aeolia_config_msi(sc, func, i, msg->address_lo, msg->data);
+	} else {
+		aeolia_config_msi(sc, func, subfunc, msg->address_lo, msg->data);
+	}
+}
+
+static void aeolia_msi_unmask(struct irq_data *data)
+{
+	struct aeolia_irq_data *irq_data = data->chip_data;
+	struct ps4sb_dev *sc = irq_data->sc;
+	u32 func = data->hwirq >> 8;
+
+	glue_set_mask(sc, AEOLIA_REG_MSI_MASK(func), data->mask);
+}
+
+static void aeolia_msi_mask(struct irq_data *data)
+{
+	struct aeolia_irq_data *irq_data = data->chip_data;
+	struct ps4sb_dev *sc = irq_data->sc;
+	u32 func = data->hwirq >> 8;
+
+	glue_clear_mask(sc, AEOLIA_REG_MSI_MASK(func), data->mask);
+}
+
+static void aeolia_msi_calc_mask(struct irq_data *data) {
+	u32 func = data->hwirq >> 8;
+	u32 subfunc = data->hwirq & 0xff;
+
+	if (subfunc == 0xff) {
+		data->mask = (1 << subfuncs_per_func[func]) - 1;
+	} else {
+		data->mask = 1 << subfunc;
+	}
+}
+
+static void aeolia_irq_msi_compose_msg(struct irq_data *data,
+				       struct msi_msg *msg)
+{
+	struct aeolia_irq_data *irq_data = data->chip_data;
+	struct irq_cfg *cfg __maybe_unused = irqd_cfg(data);
+
+	memset(msg, 0, sizeof(*msg));
+	msg->address_hi = X86_MSI_BASE_ADDRESS_HIGH;
+	msg->address_lo = 0xfee00000;// Just do it like this for now
+	msg->data = irq_data ? irq_data->msi_data : data->irq - 1;
+
+	pr_debug("aeolia_irq_msi_compose_msg\n");
+}
+
+static const struct irq_chip aeolia_msi_controller_template = {
+	.name = "Aeolia-MSI",
+	.irq_unmask = aeolia_msi_unmask,
+	.irq_mask = aeolia_msi_mask,
+	.irq_ack = irq_chip_ack_parent,
+	.irq_set_affinity = msi_domain_set_affinity,
+	.irq_retrigger = irq_chip_retrigger_hierarchy,
+	.irq_compose_msi_msg = aeolia_irq_msi_compose_msg,
+	.irq_write_msi_msg = aeolia_msi_write_msg,
+	.flags = IRQCHIP_SKIP_SET_WAKE | IRQCHIP_AFFINITY_PRE_STARTUP,
+};
+
+static irq_hw_number_t aeolia_msi_get_hwirq(struct msi_domain_info *info,
+					  msi_alloc_info_t *arg)
+{
+	return arg->hwirq;
+}
+
+static int aeolia_msi_init(struct irq_domain *domain,
+			 struct msi_domain_info *info, unsigned int virq,
+			 irq_hw_number_t hwirq, msi_alloc_info_t *arg)
+{
+	struct irq_data *data;
+	struct aeolia_irq_data *irq_data;
+	struct ps4sb_dev *sc = info->chip_data;
+	int i;
+	int slot = -1;
+
+	pr_debug("aeolia_msi_init(%p, %p, %d, 0x%lx, %p)\n",
+		 domain, info, virq, hwirq, arg);
+
+	if (sc) {
+		for (i = 0; i < ARRAY_SIZE(sc->irq_map); i++) {
+			if (sc->irq_map[i] == -1) {
+				slot = i;
+				break;
+			}
+		}
+
+		if (slot < 0) {
+			pr_err("aeolia_msi_init: no free irq_map entry for virq %u\n", virq);
+			return -ENOSPC;
+		}
+	}
+
+	irq_data = kzalloc(sizeof(*irq_data), GFP_KERNEL);
+	if (!irq_data)
+		return -ENOMEM;
+
+	irq_data->sc = sc;
+	irq_data->msi_data = slot >= 0 ? slot : virq - 1;
+
+	data = irq_domain_get_irq_data(domain, virq);
+	irq_domain_set_info(domain, virq, hwirq, info->chip, irq_data,
+			    handle_edge_irq, NULL, "edge");
+	aeolia_msi_calc_mask(data);
+
+	if (sc) {
+		sc->irq_map[slot] = virq;
+	}
+
+	return 0;
+}
+
+static void aeolia_msi_free(struct irq_domain *domain,
+			  struct msi_domain_info *info, unsigned int virq)
+{
+	struct irq_data *data;
+	struct aeolia_irq_data *irq_data;
+	struct ps4sb_dev *sc = info->chip_data;
+	int i;
+
+	data = irq_domain_get_irq_data(domain, virq);
+	irq_data = data ? data->chip_data : NULL;
+
+	if (sc) {
+		for (i = 0; i < ARRAY_SIZE(sc->irq_map); i++) {
+			if (sc->irq_map[i] == virq) {
+				sc->irq_map[i] = -1;
+				break;
+			}
+		}
+	}
+
+	pr_debug("aeolia_msi_free(%d)\n", virq);
+	kfree(irq_data);
+}
+
+
+static void aeolia_set_desc(msi_alloc_info_t *arg, struct msi_desc *desc)
+{
+	struct pci_dev *device;
+
+	arg->desc = desc;
+	device = msi_desc_to_pci_dev(desc);
+
+	arg->hwirq = PCI_FUNC(device->devfn) << 8;
+
+#ifndef QEMU_HACK_NO_IOMMU
+	arg->hwirq |= 0xFF;
+#endif
+}
+
+static struct msi_domain_ops aeolia_msi_domain_ops = {
+	.get_hwirq	= aeolia_msi_get_hwirq,
+	.set_desc       = aeolia_set_desc,
+	.msi_init	= aeolia_msi_init,
+	.msi_free	= aeolia_msi_free,
+};
+
+static const struct msi_domain_info aeolia_msi_domain_info_template = {
+	.flags		= MSI_FLAG_USE_DEF_DOM_OPS | MSI_FLAG_USE_DEF_CHIP_OPS,
+	.ops		= &aeolia_msi_domain_ops,
+	.handler	= handle_edge_irq,
+	.handler_name	= "edge"
+};
+
+static struct irq_domain *aeolia_create_irq_domain(struct ps4sb_dev *sc)
+{
+	struct ps4sb_msi_domain_ctx *ctx;
+	struct irq_domain *domain, *parent;
+	struct fwnode_handle *fn;
+	struct irq_fwspec fwspec;
+
+	sc_dbg("aeolia_create_irq_domain\n");
+	if (x86_vector_domain == NULL)
+		return NULL;
+
+	ctx = kzalloc(sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return NULL;
+
+	ctx->controller = aeolia_msi_controller_template;
+	ctx->info = aeolia_msi_domain_info_template;
+	ctx->info.chip = &ctx->controller;
+	ctx->info.chip_data = sc;
+
+	fn = irq_domain_alloc_named_id_fwnode(ctx->controller.name, pci_dev_id(sc->pdev));
+	if (!fn) {
+		kfree(ctx);
+		return NULL;
+	}
+
+	sc_dbg("devid = %d\n", pci_dev_id(sc->pdev));
+
+	fwspec.fwnode = fn;
+	fwspec.param_count = 1;
+
+	// It should be correct to put the pci device id in here
+	fwspec.param[0] = pci_dev_id(sc->pdev);
+
+	parent = irq_find_matching_fwspec(&fwspec, DOMAIN_BUS_ANY);
+	if (!parent) {
+		sc_dbg("no parent \n");
+		parent = x86_vector_domain;
+	} else if (parent == x86_vector_domain) {
+		sc_dbg("no parent \n");
+	} else {
+		ctx->info.flags |= MSI_FLAG_MULTI_PCI_MSI;
+		ctx->controller.name = "IR-Aeolia-MSI";
+	}
+
+	domain = msi_create_irq_domain(fn, &ctx->info, parent);
+	if (!domain) {
+		irq_domain_free_fwnode(fn);
+		kfree(ctx);
+		pr_warn("Failed to initialize Aeolia-MSI irqdomain.\n");
+		return NULL;
+	}
+
+	sc->msi_domain_ctx = ctx;
+	return domain;
+}
+
+static int aeolia_is_compatible_device(struct pci_dev *dev)
+{
+	if (!dev || dev->vendor != PCI_VENDOR_ID_SONY) {
+		return 0;
+	}
+	return (dev->device == PCI_DEVICE_ID_SONY_AEOLIA_PCIE ||
+		dev->device == PCI_DEVICE_ID_SONY_BELIZE_PCIE);
+}
+
+int aeolia_assign_irqs(struct pci_dev *dev, int nvec)
+{
+	int ret;
+	unsigned int sc_devfn;
+	struct pci_dev *sc_dev;
+	struct ps4sb_dev *sc;
+	struct device *bare_dev;
+	struct msi_desc *desc;
+	struct irq_alloc_info info;
+	unsigned int desc_first;
+
+	sc_devfn = (dev->devfn & ~7) | AEOLIA_FUNC_ID_PCIE;
+	sc_dev = pci_get_slot(dev->bus, sc_devfn);
+
+	if (!aeolia_is_compatible_device(sc_dev)) {
+		dev_err(&dev->dev, "aeolia: this is not an Aeolia device\n");
+		ret = -ENODEV;
+		goto fail;
+	}
+	sc = pci_get_drvdata(sc_dev);
+	if (!sc) {
+		dev_err(&dev->dev, "aeolia: not ready yet, cannot assign IRQs\n");
+		ret = -ENODEV;
+		goto fail;
+	}
+
+	init_irq_alloc_info(&info, NULL);
+	info.type = X86_IRQ_ALLOC_TYPE_PCI_MSI;
+	/* IRQs "come from" function 4 as far as the IOMMU/system see */
+	//info.msi_dev = sc->pdev;
+	info.devid = pci_dev_id(sc->pdev);
+	bare_dev = &sc->pdev->dev;
+
+	/* Our hwirq number is function << 8 plus subfunction.
+	 * Subfunction is usually 0 and implicitly increments per hwirq,
+	 * but can also be 0xff to indicate that this is a shared IRQ. */
+	info.hwirq = PCI_FUNC(dev->devfn) << 8;
+
+#ifndef QEMU_HACK_NO_IOMMU
+	if (!(sc->msi_domain_ctx->info.flags & MSI_FLAG_MULTI_PCI_MSI)) {
+		nvec = 1;
+		info.hwirq |= 0xff; /* Shared IRQ for all subfunctions */
+	}
+#endif
+
+	desc = msi_alloc_desc(bare_dev, nvec, NULL);
+	if (!desc) {
+		ret = -ENOMEM;
+		goto fail;
+	}
+	desc_first = desc->msi_index;
+
+	info.desc = desc;
+	info.data = sc;
+
+	dev_dbg(&dev->dev, "aeolia_assign_irqs(%d) (%ld)\n", nvec, info.hwirq);
+
+	ret = irq_domain_alloc_irqs(sc->irqdomain, nvec, NUMA_NO_NODE, &info);
+	if (ret >= 0) {
+		dev_dbg(&dev->dev, "irq_domain_alloc_irqs = %x\n", ret);
+		dev->irq = ret;
+		desc->irq = ret;
+		ret = nvec;
+	} else {
+		msi_free_msi_descs_range(bare_dev, desc_first,
+					 desc_first + nvec - 1);
+	}
+
+fail:
+	dev_dbg(&dev->dev, "aeolia_assign_irqs returning %d\n", ret);
+	if (sc_dev)
+		pci_dev_put(sc_dev);
+	return ret;
+}
+EXPORT_SYMBOL(aeolia_assign_irqs);
+
+void aeolia_free_irqs(unsigned int virq, unsigned int nr_irqs)
+{
+	irq_domain_free_irqs(virq, nr_irqs);
+}
+EXPORT_SYMBOL(aeolia_free_irqs);
+
+static void aeolia_glue_remove(struct ps4sb_dev *sc);
+
+static int aeolia_glue_init(struct ps4sb_dev *sc)
+{
+	int i;
+
+	sc_info("aeolia glue probe\n");
+
+	if (!request_mem_region(pci_resource_start(sc->pdev, 4) +
+				AEOLIA_RGN_PCIE_BASE, AEOLIA_RGN_PCIE_SIZE,
+				"aeolia.glue")) {
+		sc_err("Failed to request pcie region\n");
+		return -EBUSY;
+
+	}
+
+	if (!request_mem_region(pci_resource_start(sc->pdev, 2) +
+				AEOLIA_RGN_CHIPID_BASE, AEOLIA_RGN_CHIPID_SIZE,
+				"aeolia.chipid")) {
+		sc_err("Failed to request chipid region\n");
+		release_mem_region(pci_resource_start(sc->pdev, 4) +
+				   AEOLIA_RGN_PCIE_BASE, AEOLIA_RGN_PCIE_SIZE);
+		return -EBUSY;
+	}
+
+	glue_set_region(sc, AEOLIA_FUNC_ID_PCIE, 2, 0xbf018000, 0x7fff);
+
+	sc_info("Aeolia chip revision: %08x:%08x:%08x\n",
+		ioread32(sc->bar2 + AEOLIA_REG_CHIPID_0),
+		ioread32(sc->bar2 + AEOLIA_REG_CHIPID_1),
+		ioread32(sc->bar2 + AEOLIA_REG_CHIPREV));
+
+	/* Mask all MSIs first, to avoid spurious IRQs */
+	for (i = 0; i < AEOLIA_NUM_FUNCS; i++) {
+		glue_write32(sc, AEOLIA_REG_MSI_MASK(i), 0);
+		glue_write32(sc, AEOLIA_REG_MSI_ADDR(i), 0);
+		glue_write32(sc, AEOLIA_REG_MSI_DATA_HI(i), 0);
+	}
+
+	for (i = 0; i < 0xfc; i += 4)
+		glue_write32(sc, AEOLIA_REG_MSI_DATA_LO(i), 0);
+
+	glue_set_region(sc, AEOLIA_FUNC_ID_GBE, 0, 0xbfa00000, 0x3fff);
+	glue_set_region(sc, AEOLIA_FUNC_ID_AHCI, 5, 0xbfa04000, 0xfff);
+	glue_set_region(sc, AEOLIA_FUNC_ID_SDHCI, 0, 0xbfa80000, 0xfff);
+	glue_set_region(sc, AEOLIA_FUNC_ID_SDHCI, 1, 0, 0);
+	glue_set_region(sc, AEOLIA_FUNC_ID_DMAC, 0, 0xbfa05000, 0xfff);
+	glue_set_region(sc, AEOLIA_FUNC_ID_DMAC, 1, 0, 0);
+	glue_set_region(sc, AEOLIA_FUNC_ID_DMAC, 2, 0xbfa06000, 0xfff);
+	glue_set_region(sc, AEOLIA_FUNC_ID_DMAC, 3, 0, 0);
+	glue_set_region(sc, AEOLIA_FUNC_ID_MEM, 2, 0xc0000000, 0x3fffffff);
+	glue_set_region(sc, AEOLIA_FUNC_ID_MEM, 3, 0, 0);
+	glue_set_region(sc, AEOLIA_FUNC_ID_XHCI, 0, 0xbf400000, 0x1fffff);
+	glue_set_region(sc, AEOLIA_FUNC_ID_XHCI, 1, 0, 0);
+	glue_set_region(sc, AEOLIA_FUNC_ID_XHCI, 2, 0xbf600000, 0x1fffff);
+	glue_set_region(sc, AEOLIA_FUNC_ID_XHCI, 3, 0, 0);
+	glue_set_region(sc, AEOLIA_FUNC_ID_XHCI, 4, 0xbf800000, 0x1fffff);
+	glue_set_region(sc, AEOLIA_FUNC_ID_XHCI, 5, 0, 0);
+
+	sc->irqdomain = aeolia_create_irq_domain(sc);
+	if (!sc->irqdomain) {
+		sc_err("Failed to create IRQ domain");
+		aeolia_glue_remove(sc);
+		return -EIO;
+	}
+	sc->nvec = aeolia_assign_irqs(sc->pdev, AEOLIA_NUM_SUBFUNC);
+	if (sc->nvec <= 0) {
+		sc_err("Failed to assign IRQs");
+		aeolia_glue_remove(sc);
+		return -EIO;
+	}
+	sc_dbg("dev->irq=%d\n", sc->pdev->irq);
+
+	return 0;
+}
+
+static void aeolia_glue_remove(struct ps4sb_dev *sc) {
+	sc_info("aeolia glue remove\n");
+
+	if (sc->nvec > 0) {
+		aeolia_free_irqs(sc->pdev->irq, sc->nvec);
+		sc->nvec = 0;
+	}
+	if (sc->irqdomain) {
+		irq_domain_remove(sc->irqdomain);
+		sc->irqdomain = NULL;
+	}
+	kfree(sc->msi_domain_ctx);
+	sc->msi_domain_ctx = NULL;
+	release_mem_region(pci_resource_start(sc->pdev, 2) +
+			   AEOLIA_RGN_CHIPID_BASE, AEOLIA_RGN_CHIPID_SIZE);
+	release_mem_region(pci_resource_start(sc->pdev, 4) +
+			   AEOLIA_RGN_PCIE_BASE, AEOLIA_RGN_PCIE_SIZE);
+}
+
+#ifdef CONFIG_PM
+static int aeolia_glue_suspend(struct ps4sb_dev *sc, pm_message_t state) {
+	return 0;
+}
+
+static int aeolia_glue_resume(struct ps4sb_dev *sc) {
+	return 0;
+}
+#endif
+
+
+int ps4sb_uart_init(struct ps4sb_dev *sc);
+int ps4sb_icc_init(struct ps4sb_dev *sc);
+void ps4sb_uart_remove(struct ps4sb_dev *sc);
+void ps4sb_icc_remove(struct ps4sb_dev *sc);
+#ifdef CONFIG_PM
+void ps4sb_uart_suspend(struct ps4sb_dev *sc, pm_message_t state);
+void ps4sb_icc_suspend(struct ps4sb_dev *sc, pm_message_t state);
+void ps4sb_uart_resume(struct ps4sb_dev *sc);
+void ps4sb_icc_resume(struct ps4sb_dev *sc);
+#endif
+
+/* From arch/x86/platform/ps4/ps4.c */
+
+static const struct ps4sb_family aeolia_family = {
+	.name		= "Aeolia",
+	.uart_bar	= 4,
+	.uart_base	= AEOLIA_RGN_UART_BASE,
+	.uart_clock	= 58500000,
+	.uart_subfunc	= AEOLIA_SUBFUNC_UART0,
+	.uart_count	= AEOLIA_NR_UARTS,
+	.icc_bar	= 4,
+	.icc_base	= AEOLIA_RGN_ICC_BASE,
+	.icc_claim_regs	= true,
+	.icc_boot_led	= true,
+	.i2c_data_off	= 0x14,
+	.i2c_err_off	= 0x0c,
+	.rtc_bar	= 2,
+	.rtc_reg	= 0x130,
+	.rtc_byte_regs	= true,
+	.rtc_epoch	= -1431543102LL,
+};
+
+static int aeolia_probe(struct pci_dev *dev, const struct pci_device_id *id) {
+	struct ps4sb_dev *sc;
+	int ret;
+
+	dev_dbg(&dev->dev, "aeolia_probe()\n");
+
+	ret = pci_enable_device(dev);
+	if (ret) {
+		dev_err(&dev->dev,
+			"aeolia_probe(): pci_enable_device failed: %d\n", ret);
+		return ret;
+	}
+
+	sc = kzalloc(sizeof(*sc), GFP_KERNEL);
+	if (!sc) {
+		dev_err(&dev->dev, "aeolia_probe(): alloc sc failed\n");
+		ret = -ENOMEM;
+		goto disable_dev;
+	}
+	sc->pdev = dev;
+	sc->family = &aeolia_family;
+	memset(sc->irq_map, -1, sizeof(sc->irq_map));
+	memset(sc->serial_line, -1, sizeof(sc->serial_line));
+	pci_set_drvdata(dev, sc);
+
+	// eMMC ... unused?
+	sc->bar0 = pci_ioremap_bar(dev, 0);
+	// pervasive 0
+	sc->bar2 = pci_ioremap_bar(dev, 2);
+	// pervasive 1 - misc peripherals
+	sc->bar4 = pci_ioremap_bar(dev, 4);
+
+	if (!sc->bar0 || !sc->bar2 || !sc->bar4) {
+		sc_err("failed to map some BARs, bailing out\n");
+		ret = -EIO;
+		goto free_bars;
+	}
+
+	if ((ret = aeolia_glue_init(sc)) < 0)
+		goto free_bars;
+	if (ps4sb_rtc_init(sc) < 0)
+		sc_err("rtc not registered\n");
+	if ((ret = ps4sb_icc_init(sc)) < 0)
+		goto remove_glue;
+
+	WRITE_ONCE(ps4sb_initialized, true);
+	return 0;
+
+remove_glue:
+	aeolia_glue_remove(sc);
+free_bars:
+	if (sc->bar0)
+		iounmap(sc->bar0);
+	if (sc->bar2)
+		iounmap(sc->bar2);
+	if (sc->bar4)
+		iounmap(sc->bar4);
+	kfree(sc);
+disable_dev:
+	pci_disable_device(dev);
+	return ret;
+}
+
+static void aeolia_remove(struct pci_dev *dev) {
+	struct ps4sb_dev *sc;
+	sc = pci_get_drvdata(dev);
+
+	WRITE_ONCE(ps4sb_initialized, false);
+	ps4sb_icc_remove(sc);
+	ps4sb_uart_remove(sc);
+	aeolia_glue_remove(sc);
+
+	if (sc->bar0)
+		iounmap(sc->bar0);
+	if (sc->bar2)
+		iounmap(sc->bar2);
+	if (sc->bar4)
+		iounmap(sc->bar4);
+	kfree(sc);
+	pci_disable_device(dev);
+}
+
+#ifdef CONFIG_PM
+static int aeolia_suspend(struct pci_dev *dev, pm_message_t state) {
+	struct ps4sb_dev *sc;
+	sc = pci_get_drvdata(dev);
+
+	ps4sb_icc_suspend(sc, state);
+	ps4sb_uart_suspend(sc, state);
+	aeolia_glue_suspend(sc, state);
+	return 0;
+}
+
+static int aeolia_resume(struct pci_dev *dev) {
+	struct ps4sb_dev *sc;
+	sc = pci_get_drvdata(dev);
+
+	ps4sb_icc_resume(sc);
+	aeolia_glue_resume(sc);
+	ps4sb_uart_resume(sc);
+	return 0;
+}
+#endif
+
+static const struct pci_device_id aeolia_pci_tbl[] = {
+	{ PCI_DEVICE(PCI_VENDOR_ID_SONY, PCI_DEVICE_ID_SONY_AEOLIA_PCIE), },
+	{ PCI_DEVICE(PCI_VENDOR_ID_SONY, PCI_DEVICE_ID_SONY_BELIZE_PCIE), },
+	{ }
+};
+MODULE_DEVICE_TABLE(pci, aeolia_pci_tbl);
+
+static struct pci_driver aeolia_driver = {
+	.name		= "aeolia_pcie",
+	.id_table	= aeolia_pci_tbl,
+	.probe		= aeolia_probe,
+	.remove		= aeolia_remove,
+#ifdef CONFIG_PM
+	.suspend	= aeolia_suspend,
+	.resume		= aeolia_resume,
+#endif
+};
+module_pci_driver(aeolia_driver);
