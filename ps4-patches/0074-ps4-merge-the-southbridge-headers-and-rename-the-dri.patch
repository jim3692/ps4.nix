+#define PS4_SFLASH_REG_STATUS       0x00040
+#define PS4_SFLASH_REG_DMA_ADDR     0x00044
+#define PS4_SFLASH_REG_DMA_LEN      0x00048
+
+#define PS4_SFLASH_REG_CLK_STATUS   0x01000
+#define PS4_SFLASH_REG_CLK_CTRL     0x01004
+
+#define PS4_SFLASH_BK_CTRL          0x01000
+#define PS4_SFLASH_BK_CTRL_START    0x4
+#define PS4_SFLASH_BK_BITS          0x01004
+#define PS4_SFLASH_BK_ADDR          0x01030
+#define PS4_SFLASH_BK_ADDR_LEN      4
+#define PS4_SFLASH_BK_OPCODE        0x01034
+#define PS4_SFLASH_BK_RX            0x01038
+#define PS4_SFLASH_BK_IRQ_STATUS    0x010a8
+#define PS4_SFLASH_BK_IRQ_MASK      0x010ac
+#define PS4_SFLASH_BK_CFG           0x010b0
+#define PS4_SFLASH_BK_CFG_ENABLE    0x100
+#define PS4_SFLASH_BK_TIMING        0x010c4
+#define PS4_SFLASH_BK_DMA_IRQ_STATUS 0x01800
+#define PS4_SFLASH_BK_DMA_IRQ_MASK  0x01804
+#define PS4_SFLASH_BK_UNLOCK        0x04010
+#define PS4_SFLASH_BK_CLAIM_STATUS  0x0b000
+#define PS4_SFLASH_BK_CLAIM         0x0b004
+#define PS4_SFLASH_BK_PINS          0xeb420
+#define PS4_SFLASH_BK_PINS_CLEAR    0x11u
+#define PS4_SFLASH_BK_TIMEOUT_US    200000
+
+#define PS4_SFLASH_BK_OP_RDSR       0x05
+#define PS4_SFLASH_BK_OP_READ4B     0x13
+#define PS4_SFLASH_BK_OP_RDID       0x9f
+
+#define PS4_SFLASH_IOC_MAGIC        'S'
+#define PS4_SFLASH_IOC_GET_SIZE     _IOR(PS4_SFLASH_IOC_MAGIC, 1, __u32)
+#define PS4_SFLASH_IOC_GET_JEDEC    _IOR(PS4_SFLASH_IOC_MAGIC, 2, __u32)
+#define PS4_SFLASH_IOC_GET_STATUS   _IOR(PS4_SFLASH_IOC_MAGIC, 3, __u32)
+
+#endif
