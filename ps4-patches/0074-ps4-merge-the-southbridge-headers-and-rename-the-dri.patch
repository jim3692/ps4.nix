+static void baikal_handle_edge_irq(struct irq_desc *desc)
+{
+	u32 func = (desc->irq_data.hwirq >> 5) & 7;
+	u32 initial_hwirq = desc->irq_data.hwirq & ~0x1fLL;
+	unsigned int vector_to_write;
+	unsigned int mask;
+	char shift;
+
+	if (func == 4)
+	{
+		vector_to_write = 2;
+		mask = -1;
+		shift = 0;
+	}
+	else if (func == 7)
+	{
+		vector_to_write = 3;
+		mask = 7;
+		shift = 0x10;
+	}
+	else if (func == 5)
+	{
+		mask = 3;
+		vector_to_write = 3;
+		shift = 0;
+	} else {
+		handle_edge_irq(desc);
+		return;
+	}
+
+	raw_spin_lock(&desc->lock);
+	struct ps4sb_dev *sc = desc->irq_data.chip_data;
+	glue_write32(sc, BAIKAL_ACK_WRITE, vector_to_write);
+	u32 vector_read = glue_read32(sc, BAIKAL_ACK_READ);
+	raw_spin_unlock(&desc->lock);
+
+	unsigned int subfunc_mask = mask & ~(vector_read >> shift);
+	bool run_self = !subfunc_mask;
+	unsigned int i;
+
+	for (i = 0; i < 32; i++) {
+		unsigned int virq;
+		struct irq_desc *new_desc;
+
+		if (!(subfunc_mask & BIT(i)))
+			continue;
+
+		virq = irq_find_mapping(desc->irq_data.domain, initial_hwirq + i);
+		new_desc = virq ? irq_to_desc(virq) : NULL;
+		if (!new_desc || new_desc == desc) {
+			run_self = true;
+			continue;
+		}
+		handle_edge_irq(new_desc);
+	}
+
+	if (run_self)
+		handle_edge_irq(desc);
+}
+
+static int baikal_msi_init(struct irq_domain *domain,
+			 struct msi_domain_info *info, unsigned int virq,
+			 irq_hw_number_t hwirq, msi_alloc_info_t *arg)
+{
+	struct ps4sb_dev *sc = info->chip_data;
+
+	irq_domain_set_info(domain, virq, hwirq, info->chip, info->chip_data,
+			baikal_handle_edge_irq, NULL, "edge");
+
+	if (sc) {
+		int i;
+		for (i = 0; i < 100; i++) {
+			if (sc->irq_map[i] == -1) {
+				sc->irq_map[i] = virq;
+				break;
+			}
+		}
+	}
+
+	return 0;
+}
