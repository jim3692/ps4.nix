+};
+
+/* MSI registers for up to 31, but only 23 known. */
+#define AEOLIA_NUM_SUBFUNC		23
+
+/* Sub-functions, aka MSI vectors */
+enum aeolia_subfunc {
+	AEOLIA_SUBFUNC_GLUE	= 0,
+	AEOLIA_SUBFUNC_ICC	= 3,
+	AEOLIA_SUBFUNC_HPET	= 5,
