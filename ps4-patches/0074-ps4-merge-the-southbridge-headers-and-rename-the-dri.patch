-}
-
-
-static void apcie_set_desc(msi_alloc_info_t *arg, struct msi_desc *desc)
-{
-	struct pci_dev *device;
-
-	arg->desc = desc;
-	device = msi_desc_to_pci_dev(desc);
-
-	arg->hwirq = PCI_FUNC(device->devfn) << 8;
