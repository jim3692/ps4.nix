-static u32 bpcie_sata_trace_length(u8 trace)
-{
-	u32 length = trace & 0x1f;
-
-	if (trace > 0x5f)
-		length += (trace >> 5) - 2;
-	if (!trace || length > 18)
-		length = BAIKAL_SATA_TRACE_DEFAULT;
-	return length;
-}
