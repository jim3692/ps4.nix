From 39d4f90a791808c6152e1574bdcde3011c1f5bc2 Mon Sep 17 00:00:00 2001
From: Armandas Kvietkus <armandas.kvietkus@proton.me>
Date: Sun, 10 May 2026 20:02:37 +0200
Subject: [PATCH 034/124] ps4: fix the probe and irq paths

Signed-off-by: Armandas Kvietkus <armandas.kvietkus@proton.me>
---
 arch/x86/pci/irq.c             | 8 ++++----
 drivers/acpi/osl.c             | 8 ++++++++
 drivers/ps4/ps4-apcie-icc.c    | 4 ++--
 drivers/usb/host/xhci-aeolia.c | 2 +-
 4 files changed, 15 insertions(+), 7 deletions(-)

diff --git a/arch/x86/pci/irq.c b/arch/x86/pci/irq.c
index 0de436316a1dd147c057ac6b2db56701e357834f..cbba24b925820da475e00776d039a27411649197 100644
--- a/arch/x86/pci/irq.c
+++ b/arch/x86/pci/irq.c
@@ -676,7 +676,6 @@ static int pirq_cyrix_set(struct pci_dev *router, struct pci_dev *dev, int pirq,
 	return 1;
 }
 
-
 /*
  *	PIRQ routing for the SiS85C497 AT Bus Controller & Megacell (ATM)
  *	ISA bridge used with the SiS 85C496/497 486 Green PC VESA/ISA/PCI
@@ -845,7 +844,6 @@ static int pirq_sis503_set(struct pci_dev *router, struct pci_dev *dev,
 	return 1;
 }
 
-
 /*
  * VLSI: nibble offset 0x74 - educated guess due to routing table and
  *       config space of VLSI 82C534 PCI-bridge/router (1004:0102)
@@ -1115,7 +1113,6 @@ static __init int vlsi_router_probe(struct irq_router *r, struct pci_dev *router
 	return 0;
 }
 
-
 static __init int serverworks_router_probe(struct irq_router *r,
 		struct pci_dev *router, u16 device)
 {
@@ -1258,7 +1255,6 @@ static __initdata struct irq_router_handler pirq_routers[] = {
 static struct irq_router pirq_router;
 static struct pci_dev *pirq_router_dev;
 
-
 /*
  *	FIXME: should we have an option to say "generic for
  *	chipset" ?
@@ -1720,6 +1716,10 @@ static int pirq_enable_irq(struct pci_dev *dev)
 {
 	u8 pin = 0;
 
+	if (!boot_cpu_has(X86_FEATURE_HYPERVISOR) && boot_cpu_data.x86_vendor == X86_VENDOR_AMD && boot_cpu_data.x86 == 0x16) {
+		return 0;
+	}
+
 	pci_read_config_byte(dev, PCI_INTERRUPT_PIN, &pin);
 	if (pin && !pcibios_lookup_irq(dev, 1)) {
 		char *msg = "";
diff --git a/drivers/acpi/osl.c b/drivers/acpi/osl.c
index ed2162a97bd2aa3f7c79706d238092a6b0399332..c65cfed8c4822a13fe7b2f23a27658107ea864c8 100644
--- a/drivers/acpi/osl.c
+++ b/drivers/acpi/osl.c
@@ -577,6 +577,14 @@ acpi_os_install_interrupt_handler(u32 gsi, acpi_osd_handler handler,
 	if (acpi_irq_handler)
 		return AE_ALREADY_ACQUIRED;
 
+	if (gsi == 9 && !boot_cpu_has(X86_FEATURE_HYPERVISOR) && boot_cpu_data.x86_vendor == X86_VENDOR_AMD && boot_cpu_data.x86 == 0x16) {
+		pr_info("ACPI: Bypassing SCI allocation for PS4\n");
+		acpi_irq_handler = handler;
+		acpi_irq_context = context;
+		acpi_sci_irq = INVALID_ACPI_IRQ;
+		return AE_OK;
+	}
+
 	if (acpi_gsi_to_irq(gsi, &irq) < 0) {
 		pr_err("SCI (ACPI GSI %d) not registered\n", gsi);
 		return AE_OK;
diff --git a/drivers/ps4/ps4-apcie-icc.c b/drivers/ps4/ps4-apcie-icc.c
index fb33f939d698bd355f8e3b45c10511a4cc30e7cc..66c63f33c92d400f3d83b48c77a4ab65296d3939 100644
--- a/drivers/ps4/ps4-apcie-icc.c
+++ b/drivers/ps4/ps4-apcie-icc.c
@@ -620,13 +620,13 @@ int apcie_icc_init(struct apcie_dev *sc)
 	}
 
 	ret = register_chrdev(0, "icc", &icc_fops);
-	if (ret) {
+	if (ret < 0) {
 		sc_warn("icc: register_chrdev failed: %d\n", ret);
 		kfree(ioctl_reply_buf);
 		kfree(ioctl_send_buf);
 		ioctl_reply_buf = NULL;
 		ioctl_send_buf = NULL;
-		goto done;
+		goto unassign_global;
 	}
 	icc_major = ret;
 	icc_chrdev_registered = true;
diff --git a/drivers/usb/host/xhci-aeolia.c b/drivers/usb/host/xhci-aeolia.c
index 8e24d42945b91f92dad3a2ab94a31d4691bd1a2e..b1f82b00e20fb66541ed674268822b6893622cca 100644
--- a/drivers/usb/host/xhci-aeolia.c
+++ b/drivers/usb/host/xhci-aeolia.c
@@ -60,7 +60,7 @@ static int xhci_aeolia_probe_one(struct pci_dev *dev, int index)
 	struct hc_driver *driver = &xhci_aeolia_hc_driver;
 	struct usb_hcd *hcd;
 	struct xhci_hcd *xhci;
-	int irq = (axhci->nr_irqs > 1) ? (dev->irq + index) : dev->irq;
+	int irq = (dev->msi_enabled && axhci->nr_irqs > 1) ? (dev->irq + index) : dev->irq;
 
 	dev_dbg(&dev->dev, "xhci_aeolia_probe_one %d\n", index);
 	usleep_range(200, 500);
