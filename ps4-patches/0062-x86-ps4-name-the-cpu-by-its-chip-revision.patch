From e93e6cad3a2b5823c3aa05c7bb768ed2715d2ae4 Mon Sep 17 00:00:00 2001
From: Armandas Kvietkus <armandas.kvietkus@proton.me>
Date: Fri, 6 Nov 2026 18:16:59 +0100
Subject: [PATCH 062/124] x86: ps4: name the cpu by its chip revision

Signed-off-by: Armandas Kvietkus <armandas.kvietkus@proton.me>
---
 arch/x86/kernel/cpu/amd.c     | 45 +++++++++++++++++++++++++++++++++--
 drivers/cpufreq/Kconfig.x86   |  6 ++---
 drivers/cpufreq/ps4-cpufreq.c |  2 +-
 3 files changed, 47 insertions(+), 6 deletions(-)

diff --git a/arch/x86/kernel/cpu/amd.c b/arch/x86/kernel/cpu/amd.c
index 18f755956708a79b7ccbebbcb79bd1676590fd0c..260c30a4786fc08df704508436f213f9791abf3b 100644
--- a/arch/x86/kernel/cpu/amd.c
+++ b/arch/x86/kernel/cpu/amd.c
@@ -845,6 +845,48 @@ static void clear_rdrand_cpuid_bit(struct cpuinfo_x86 *c)
 	pr_info_once("BIOS may not properly restore RDRAND after suspend, hiding RDRAND via CPUID. Use rdrand=force to reenable.\n");
 }
 
+#ifdef CONFIG_X86_PS4
+static const struct {
+	u32 sig;
+	const char *name;
+} ps4_cpu_names[] = {
+	{ 0x710f00, "AMD LVPJ-A0" },
+	{ 0x710f10, "AMD LVPJ-B0" },
+	{ 0x710f11, "AMD LVPJ-B1" },
+	{ 0x710f12, "AMD LVPJ-B2" },
+	{ 0x710f13, "AMD LVPJ-B3" },
+	{ 0x710f30, "AMD LVPP-A0" },
+	{ 0x710f31, "AMD LVPP-A0b" },
+	{ 0x710f80, "AMD LVP2-A0" },
+	{ 0x710f81, "AMD LVP2-A1" },
+	{ 0x710fa0, "AMD LVP2C-A0" },
+	{ 0x710fc0, "AMD LVP3-A0" },
+	{ 0x740f00, "AMD GL-A0" },
+	{ 0x740f01, "AMD GL-A1" },
+	{ 0x740f10, "AMD GL-B0" },
+	{ 0x740f11, "AMD GL-B1" },
+	{ 0x740f12, "AMD GL-B2" },
+	{ 0x740f30, "AMD GLC-A0" },
+};
+
+static void ps4_set_cpu_name(struct cpuinfo_x86 *c)
+{
+	u32 sig = cpuid_eax(1);
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(ps4_cpu_names); i++) {
+		if (ps4_cpu_names[i].sig == sig) {
+			strscpy(c->x86_model_id, ps4_cpu_names[i].name);
+			return;
+		}
+	}
+	if ((sig & 0xffff00) == 0x710f00)
+		strscpy(c->x86_model_id, "AMD LVP");
+	else if ((sig & 0xffff00) == 0x740f00)
+		strscpy(c->x86_model_id, "AMD GL");
+}
+#endif
+
 static void init_amd_jg(struct cpuinfo_x86 *c)
 {
 	/*
@@ -855,8 +897,7 @@ static void init_amd_jg(struct cpuinfo_x86 *c)
 	clear_rdrand_cpuid_bit(c);
 
 #ifdef CONFIG_X86_PS4
-	if (c->x86_model <= 0x30)
-		strscpy(c->x86_model_id, "AMD Jaguar");
+	ps4_set_cpu_name(c);
 #endif
 }
 
diff --git a/drivers/cpufreq/Kconfig.x86 b/drivers/cpufreq/Kconfig.x86
index d24ec3659e2bf65249733b1d09541149c7023dfa..e9998e48a2f727e63195249be805d3e7cf7d4a39 100644
--- a/drivers/cpufreq/Kconfig.x86
+++ b/drivers/cpufreq/Kconfig.x86
@@ -34,11 +34,11 @@ config X86_PCC_CPUFREQ
 	  If in doubt, say N.
 
 config PS4_CPUFREQ
-	bool "PS4 (AMD Thebe) cpufreq driver"
+	bool "PS4 cpufreq driver"
 	depends on X86 && CPU_SUP_AMD
 	help
-	  This driver adds cpufreq support for the PS4's AMD Thebe
-	  (Family 16h) APU, using the hardware P-state MSR interface
+	  This driver adds cpufreq support for the PS4 Family 16h
+	  APU, using the hardware P-state MSR interface
 	  directly.
 
 config X86_AMD_PSTATE
diff --git a/drivers/cpufreq/ps4-cpufreq.c b/drivers/cpufreq/ps4-cpufreq.c
index 527659fec81655d34e420871f7d2c136ab4ee43a..36e394a6f43ab0b051efad043310adc2985fdae7 100644
--- a/drivers/cpufreq/ps4-cpufreq.c
+++ b/drivers/cpufreq/ps4-cpufreq.c
@@ -151,4 +151,4 @@ static int __init ps4_cpufreq_init(void)
 device_initcall(ps4_cpufreq_init);
 
 MODULE_AUTHOR("Armandas Kvietkus <armandas.kvietkus@proton.me>");
-MODULE_DESCRIPTION("cpufreq driver for PS4 (AMD Jaguar, Family 16h)");
+MODULE_DESCRIPTION("cpufreq driver for PS4 (Family 16h)");
