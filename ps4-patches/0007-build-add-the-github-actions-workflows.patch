+
+      - name: Get kernel version name env
+        id: kernel-version-env
+        run: |
+          localversion=`cat .config | grep LOCALVERSION | sed -nE 's|^.*=||p' | tr -d '\"'`
+          echo "localversion is originally = $localversion"
