+#define PS4_LED_ICC_MINOR       0x20
+#define PS4_LED_PAYLOAD_LEN     35
+
+#define PS4_LED_TEMP_COOL_MAX   65
+#define PS4_LED_TEMP_WARM_MAX   80
+
