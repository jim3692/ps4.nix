diff --git a/drivers/ps4/ps4-bpcie-uart.c b/drivers/ps4/ps4-bpcie-uart.c
new file mode 100644
index 0000000000000000000000000000000000000000..4bce97fedd29adf98d2a343d1424917481068c54
--- /dev/null
