+static struct msi_domain_ops bpcie_msi_domain_ops = {
+	.get_hwirq	= bpcie_msi_get_hwirq,
+	.msi_init	= bpcie_msi_init,
+	.msi_free	= bpcie_msi_free,
+	.set_desc	= bpcie_msi_domain_set_desc,
+	.msi_prepare = bpcie_msi_prepare,
+};
