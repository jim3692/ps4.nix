 static struct ata_port_operations ahci_vt8251_ops = {
 	.inherits		= &ahci_ops,
 	.reset.hardreset	= ahci_vt8251_hardreset,
@@ -1598,9 +1615,11 @@ static const struct pci_device_id ahci_pci_tbl[] = {
 	}, {
 		PCI_VDEVICE(SONY, PCI_DEVICE_ID_SONY_BELIZE_AHCI),
