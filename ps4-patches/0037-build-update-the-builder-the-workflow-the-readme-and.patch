diff --git a/.github/workflows/build-kernel_latest.yaml b/.github/workflows/build-kernel_latest.yaml
index f42c76826c2671ccfc015341ea12ea81eeb69cb1..2a332760f9e6633d7e59591bcb01da982a9a0e73 100644
--- a/.github/workflows/build-kernel_latest.yaml
