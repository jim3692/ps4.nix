 on:
   workflow_dispatch:
@@ -20,6 +20,14 @@ on:
         options:
           - ThinLTO
           - FullLTO
+      southbridge:
+        description: "PS4 Southbridge Target"
+        required: true
+        default: "AeoliaBelize"
+        type: choice
+        options:
+          - AeoliaBelize
+          - Baikal
   push:
     tags:
       - "v*"
@@ -43,9 +51,11 @@ jobs:
         run: |
           PROFILE_INPUT="${{ github.event_name == 'workflow_dispatch' && inputs.profile || 'Server' }}"
           LTO_INPUT="${{ github.event_name == 'workflow_dispatch' && inputs.lto || 'ThinLTO' }}"
+          SOUTHBRIDGE_INPUT="${{ github.event_name == 'workflow_dispatch' && inputs.southbridge || 'AeoliaBelize' }}"
 
           PROFILE_INPUT="$(echo "$PROFILE_INPUT" | tr '[:upper:]' '[:lower:]')"
           LTO_INPUT="$(echo "$LTO_INPUT" | tr '[:upper:]' '[:lower:]')"
+          SOUTHBRIDGE_INPUT="$(echo "$SOUTHBRIDGE_INPUT" | tr '[:upper:]' '[:lower:]')"
 
           case "$PROFILE_INPUT" in
             general)
@@ -65,6 +75,15 @@ jobs:
               ;;
           esac
 
+          case "$SOUTHBRIDGE_INPUT" in
+            baikal)
+              TARGET_SOUTHBRIDGE="Baikal"
+              ;;
+            *)
+              TARGET_SOUTHBRIDGE="AeoliaBelize"
+              ;;
+          esac
+
           case "${TARGET_LTO}:${TARGET_PROFILE}" in
             ThinLTO:Server)
               SWAP_GB="16"
@@ -82,7 +101,8 @@ jobs:
 
           echo "target_profile=${TARGET_PROFILE}" >> "$GITHUB_OUTPUT"
           echo "target_lto=${TARGET_LTO}" >> "$GITHUB_OUTPUT"
-          echo "cache_suffix=${TARGET_PROFILE}-${TARGET_LTO}" >> "$GITHUB_OUTPUT"
+          echo "target_southbridge=${TARGET_SOUTHBRIDGE}" >> "$GITHUB_OUTPUT"
+          echo "cache_suffix=${TARGET_PROFILE}-${TARGET_LTO}-${TARGET_SOUTHBRIDGE}" >> "$GITHUB_OUTPUT"
           echo "swap_gb=${SWAP_GB}" >> "$GITHUB_OUTPUT"
 
       - name: Restore Cache of Github Workspace
@@ -100,6 +120,26 @@ jobs:
           fetch-depth: 1
           clean: false
 
+      - name: Fetch private and custom firmware
+        run: |
+          # Fetch Marvel firmware (private repo)
+          git clone --depth=1 \
+            https://x-access-token:${{ secrets.FW_REPO_PAT }}@github.com/sony-jaguar-devs/firmware.git \
+            /tmp/jaguar-fw
+
+          mkdir -p kernel-source-host/extra_firmware/mrvl
+          cp /tmp/jaguar-fw/sd8797_uapsta.bin kernel-source-host/extra_firmware/mrvl/sd8797_uapsta.bin
+          test -s kernel-source-host/extra_firmware/mrvl/sd8797_uapsta.bin
+
+          # Fetch GPU firmware (private repo)
+          git clone --depth=1 \
+            https://x-access-token:${{ secrets.FW_REPO_PAT }}@github.com/sony-jaguar-devs/orbis_gpu_blobs_ps4.git \
+            /tmp/gpu-fw
+          mkdir -p kernel-source-host/extra_firmware/amdgpu
+          cp /tmp/gpu-fw/lib/firmware/amdgpu/*.bin kernel-source-host/extra_firmware/amdgpu/
+          
+          rm -rf /tmp/jaguar-fw /tmp/gpu-fw
+
       - name: Copy Dockerfile and .dockerignore to workspace root
