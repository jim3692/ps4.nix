+mkdir -p "${KERNEL_SOURCE_DIR}/extra_firmware/mrvl"
+cp /tmp/jaguar-fw/sd8797_uapsta.bin "${KERNEL_SOURCE_DIR}/extra_firmware/mrvl/sd8797_uapsta.bin"
